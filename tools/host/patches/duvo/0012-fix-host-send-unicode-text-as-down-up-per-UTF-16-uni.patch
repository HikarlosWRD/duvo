+/**
+ * @file tests/unit/test_orbit_unicode.cpp
+ * @brief Test src/orbit/unicode_events.h
+ */
+#include "../tests_common.h"
+
+#include <src/orbit/unicode_events.h>
+
+TEST(OrbitUnicode, DownUpPerUnitInOrder) {
+  const std::uint16_t t[] = {'a', ' ', 'b'};
+  auto ev = orbit::unicode_key_events(t, 3);
+  std::vector<orbit::UnicodeKeyEvent> want = {{'a', false}, {'a', true}, {' ', false}, {' ', true}, {'b', false}, {'b', true}};
+  EXPECT_EQ(ev, want);
+}
+
+TEST(OrbitUnicode, SurrogatePairKeepsHighThenLow) {
+  const std::uint16_t t[] = {0xD83D, 0xDE00};
+  auto ev = orbit::unicode_key_events(t, 2);
+  std::vector<orbit::UnicodeKeyEvent> want = {{0xD83D, false}, {0xD83D, true}, {0xDE00, false}, {0xDE00, true}};
+  EXPECT_EQ(ev, want);
+}
+
+TEST(OrbitUnicode, EmptyYieldsNothing) {
+  EXPECT_TRUE(orbit::unicode_key_events(nullptr, 0).empty());
+}
