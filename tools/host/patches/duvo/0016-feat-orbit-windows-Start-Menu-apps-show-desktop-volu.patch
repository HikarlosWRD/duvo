+/**
+ * @file tests/unit/test_windows_api.cpp
+ * @brief Test src/orbit/windows_api.* (window, app, desktop and volume endpoints) with a fake platform.
+ */
+#include "../tests_common.h"
+
+#include <nlohmann/json.hpp>
+#include <src/orbit/windows_api.h>
+
+namespace {
+  struct FakeWindows: orbit::WindowPlatform {
+    std::vector<orbit::WindowInfo> windows {{0x1234, "Doc - Notepad", "notepad.exe"}, {0x5678, "Admin console", "cmd.exe"}};
+    std::vector<orbit::AppEntry> apps {{"b2", "Zeta", "C:\\z.lnk"}, {"a1", "alpha", "C:\\a.lnk"}};
+    uint64_t elevated_id = 0x5678;
+    int calls = 0;
+    uint64_t activated = 0;
+    std::string launched;
+    int volume = -1;
+    int mute = -1;  // -1 = not called
+
+    std::vector<orbit::WindowInfo> list() override {
+      ++calls;
+      return windows;
+    }
+
+    orbit::ActivateResult activate(uint64_t id) override {
+      ++calls;
+      if (id == elevated_id) {
+        return orbit::ActivateResult::denied;
+      }
+      for (auto &w : windows) {
+        if (w.id == id) {
+          activated = id;
+          return orbit::ActivateResult::ok;
+        }
+      }
+      return orbit::ActivateResult::not_found;
+    }
+
+    bool show_desktop() override {
+      ++calls;
+      return true;
+    }
+
+    std::vector<orbit::AppEntry> start_menu() override {
+      ++calls;
+      return apps;
+    }
+
+    bool launch(const std::string &id) override {
+      ++calls;
+      launched = id;
+      return true;
+    }
+
+    bool set_volume(int level) override {
+      ++calls;
+      volume = level;
+      return true;
+    }
+
+    bool set_mute(bool m) override {
+      ++calls;
+      mute = m ? 1 : 0;
+      return true;
+    }
+  };
+
+  crypto::named_cert_t cert_with(crypto::PERM perm) {
+    crypto::named_cert_t c {};
+    c.name = "Poco";
+    c.perm = perm;
+    return c;
+  }
+
+  crypto::PERM all_but(crypto::PERM bit) {
+    return static_cast<crypto::PERM>(static_cast<uint32_t>(crypto::PERM::_all) & ~static_cast<uint32_t>(bit));
+  }
+
+  const auto kWindowsPerm = crypto::PERM::orbit_windows;
+}  // namespace
+
+TEST(WindowsApi, ListsWindowsAsJson) {
+  FakeWindows p;
+  auto c = cert_with(kWindowsPerm);
+  auto r = orbit::windows_list_reply(&c, p);
+  ASSERT_EQ(r.status, 200);
+  auto j = nlohmann::json::parse(r.body);
+  ASSERT_EQ(j["windows"].size(), 2u);
+  EXPECT_EQ(j["windows"][0]["id"].get<uint64_t>(), 0x1234u);
+  EXPECT_EQ(j["windows"][0]["title"], "Doc - Notepad");
+  EXPECT_EQ(j["windows"][0]["process"], "notepad.exe");
+}
+
+TEST(WindowsApi, ActivateMissingIs404) {
+  FakeWindows p;
+  auto c = cert_with(kWindowsPerm);
+  auto r = orbit::window_activate_reply(&c, p, {{"id", "999"}});
+  EXPECT_EQ(r.status, 404);
+  EXPECT_EQ(nlohmann::json::parse(r.body)["error"], "not_found");
+
+  EXPECT_EQ(orbit::window_activate_reply(&c, p, {{"id", std::to_string(0x1234)}}).status, 200);
+  EXPECT_EQ(p.activated, 0x1234u);
+
+  EXPECT_EQ(orbit::window_activate_reply(&c, p, {}).status, 400);
+  EXPECT_EQ(orbit::window_activate_reply(&c, p, {{"id", "x1"}}).status, 400);
+}
+
+TEST(WindowsApi, ActivateElevatedIs409) {
+  FakeWindows p;
+  auto c = cert_with(kWindowsPerm);
+  auto r = orbit::window_activate_reply(&c, p, {{"id", std::to_string(0x5678)}});
+  EXPECT_EQ(r.status, 409);
+  EXPECT_EQ(nlohmann::json::parse(r.body)["error"], "denied");
+}
+
+TEST(WindowsApi, RequiresOrbitWindowsPerm) {
+  FakeWindows p;
+  auto c = cert_with(all_but(kWindowsPerm));
+  EXPECT_EQ(orbit::windows_list_reply(&c, p).status, 403);
+  EXPECT_EQ(orbit::window_activate_reply(&c, p, {{"id", "4660"}}).status, 403);
+  EXPECT_EQ(orbit::desktop_reply(&c, p).status, 403);
+  EXPECT_EQ(orbit::apps_list_reply(&c, p).status, 403);
+  EXPECT_EQ(orbit::app_launch_reply(&c, p, {{"id", "a1"}}).status, 403);
+  EXPECT_EQ(p.calls, 0);
+
+  EXPECT_EQ(orbit::windows_list_reply(nullptr, p).status, 401);
+  EXPECT_EQ(orbit::desktop_reply(nullptr, p).status, 401);
+  EXPECT_EQ(p.calls, 0);
+
+  auto ok = cert_with(kWindowsPerm);
+  EXPECT_EQ(orbit::desktop_reply(&ok, p).status, 200);
+}
+
+TEST(WindowsApi, AppsSortedByNameAndLaunchById) {
+  FakeWindows p;
+  auto c = cert_with(kWindowsPerm);
+  auto r = orbit::apps_list_reply(&c, p);
+  ASSERT_EQ(r.status, 200);
+  auto j = nlohmann::json::parse(r.body);
+  ASSERT_EQ(j["apps"].size(), 2u);
+  EXPECT_EQ(j["apps"][0]["name"], "alpha");
+  EXPECT_EQ(j["apps"][0]["id"], "a1");
+  EXPECT_FALSE(j["apps"][0].contains("path"));
+  EXPECT_EQ(j["apps"][1]["name"], "Zeta");
+
+  EXPECT_EQ(orbit::app_launch_reply(&c, p, {{"id", "b2"}}).status, 200);
+  EXPECT_EQ(p.launched, "b2");
+  EXPECT_EQ(orbit::app_launch_reply(&c, p, {{"id", "nope"}}).status, 404);
+  EXPECT_EQ(orbit::app_launch_reply(&c, p, {}).status, 400);
+}
+
+TEST(WindowsApi, AppIdIsStableAndCaseInsensitive) {
+  auto a = orbit::app_id_for_path("C:\\ProgramData\\Start Menu\\Programs\\Calc.lnk");
+  EXPECT_EQ(a, orbit::app_id_for_path("c:\\programdata\\start menu\\programs\\calc.lnk"));
+  EXPECT_NE(a, orbit::app_id_for_path("C:\\ProgramData\\Start Menu\\Programs\\Other.lnk"));
+  EXPECT_EQ(a.size(), 16u);
+}
+
+TEST(VolumeApi, ClampsLevel) {
+  FakeWindows p;
+  auto c = cert_with(crypto::PERM::input_kbd);
+  EXPECT_EQ(orbit::volume_reply(&c, p, {{"level", "150"}}).status, 200);
+  EXPECT_EQ(p.volume, 100);
+  EXPECT_EQ(orbit::volume_reply(&c, p, {{"level", "-5"}}).status, 200);
+  EXPECT_EQ(p.volume, 0);
+  EXPECT_EQ(orbit::volume_reply(&c, p, {{"level", "42"}}).status, 200);
+  EXPECT_EQ(p.volume, 42);
+  EXPECT_EQ(p.mute, -1);
+}
+
+TEST(VolumeApi, MuteAndValidation) {
+  FakeWindows p;
+  auto c = cert_with(crypto::PERM::input_kbd);
+  EXPECT_EQ(orbit::volume_reply(&c, p, {{"mute", "1"}}).status, 200);
+  EXPECT_EQ(p.mute, 1);
+  EXPECT_EQ(orbit::volume_reply(&c, p, {{"mute", "0"}}).status, 200);
+  EXPECT_EQ(p.mute, 0);
+  EXPECT_EQ(p.volume, -1);
+
+  EXPECT_EQ(orbit::volume_reply(&c, p, {}).status, 400);
+  EXPECT_EQ(orbit::volume_reply(&c, p, {{"mute", "2"}}).status, 400);
+  EXPECT_EQ(orbit::volume_reply(&c, p, {{"level", "loud"}}).status, 400);
+
+  auto no_kbd = cert_with(all_but(crypto::PERM::input_kbd));
+  int before = p.calls;
+  EXPECT_EQ(orbit::volume_reply(&no_kbd, p, {{"level", "10"}}).status, 403);
+  EXPECT_EQ(orbit::volume_reply(nullptr, p, {{"level", "10"}}).status, 401);
+  EXPECT_EQ(p.calls, before);
+}
