+/**
+ * @file src/orbit/power_api.h
+ * @brief Power actions (/orbit/power?action=shutdown|restart|sleep|logoff|lock).
+ */
+#pragma once
+
+#include "api_reply.h"
+
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace orbit {
+  enum class PowerAction {
+    shutdown,
+    restart,
+    sleep,
+    logoff,
+    lock
+  };
+
+  /// System side of /orbit/power. Implementations must not throw.
+  class PowerPlatform {
+  public:
+    virtual ~PowerPlatform() = default;
+    virtual bool run(PowerAction action) = 0;
+  };
+
+  /// Windows implementation (platform_windows_win.cpp). Never null.
+  std::shared_ptr<PowerPlatform> make_platform_power();
+
+  std::optional<PowerAction> parse_power_action(std::string_view s);
+  const char *power_action_name(PowerAction a);
+
+  using log_fn = std::function<void(const std::string &)>;
+
+  /**
+   * @brief POST /orbit/power?action=. Needs orbit_power; unknown/missing action -> 400.
+   * Logs "[Orbit] power <action> pedido por <device name>" (to `log`, or the host log at info when empty)
+   * before running the action; 500 when the action fails.
+   */
+  ApiReply power_reply(const crypto::named_cert_t *cert, PowerPlatform &p, const Query &query, const log_fn &log = {});
+}  // namespace orbit
