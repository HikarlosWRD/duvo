+ */
+/**
+ * @file src/orbit/windows_api.h
+ * @brief Window switching, Start Menu apps, show desktop and volume (/orbit/windows, /orbit/apps, /orbit/desktop, /orbit/volume).
+ */
+#pragma once
+
+#include "api_reply.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace orbit {
+  /// A visible top-level window. `id` is the HWND value.
+  struct WindowInfo {
+    uint64_t id;
+    std::string title;
+    std::string process;  ///< image name, e.g. "notepad.exe"
+  };
+
+  /// A Start Menu shortcut. `id` is a stable hash of `path`; `name` is the file stem.
+  struct AppEntry {
+    std::string id;
+    std::string name;
+    std::string path;  ///< full .lnk path (UTF-8); never sent to clients
+  };
+
+  enum class ActivateResult {
+    ok,
+    not_found,  ///< no such window
+    denied  ///< elevated/higher integrity target or Windows refused the switch
+  };
+
+  /// System side of the window/app/volume endpoints. Implementations must not throw.
+  class WindowPlatform {
+  public:
+    virtual ~WindowPlatform() = default;
+    virtual std::vector<WindowInfo> list() = 0;
+    virtual ActivateResult activate(uint64_t id) = 0;
+    virtual bool show_desktop() = 0;
+    virtual std::vector<AppEntry> start_menu() = 0;
+    /// Launch the Start Menu entry with this id as the logged-in user.
+    virtual bool launch(const std::string &id) = 0;
+    /// Master volume 0..100.
+    virtual bool set_volume(int level) = 0;
+    virtual bool set_mute(bool mute) = 0;
+  };
+
+  /// Windows implementation (platform_windows_win.cpp). Never null.
+  std::shared_ptr<WindowPlatform> make_platform_windows();
+
+  /// Stable id for a shortcut path (FNV-1a 64 of the lower-cased path, 16 hex digits).
+  std::string app_id_for_path(const std::string &path);
+
+  /// GET /orbit/windows -> {"windows":[{id,title,process}]}. Needs orbit_windows.
+  ApiReply windows_list_reply(const crypto::named_cert_t *cert, WindowPlatform &p);
+
+  /// POST /orbit/windows/activate?id= -> 200, 400 bad id, 404 not_found, 409 denied. Needs orbit_windows.
+  ApiReply window_activate_reply(const crypto::named_cert_t *cert, WindowPlatform &p, const Query &query);
+
+  /// POST /orbit/desktop. Needs orbit_windows.
+  ApiReply desktop_reply(const crypto::named_cert_t *cert, WindowPlatform &p);
+
+  /// GET /orbit/apps -> {"apps":[{id,name}]} sorted by name. Needs orbit_windows.
+  ApiReply apps_list_reply(const crypto::named_cert_t *cert, WindowPlatform &p);
+
+  /// POST /orbit/apps/launch?id= -> 200, 400 missing id, 404 not_found, 500 launch failed. Needs orbit_windows.
+  ApiReply app_launch_reply(const crypto::named_cert_t *cert, WindowPlatform &p, const Query &query);
+
+  /// POST /orbit/volume?level=0..100 (clamped) and/or mute=0|1. Needs input_kbd.
+  ApiReply volume_reply(const crypto::named_cert_t *cert, WindowPlatform &p, const Query &query);
+}  // namespace orbit
