+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+/**
+ * @file src/orbit/windows_api.cpp
+ * @brief Window switching, Start Menu apps, show desktop and volume endpoints (platform independent part).
+ */
+#include "windows_api.h"
+
+#include <algorithm>
+#include <cctype>
+#include <charconv>
+#include <cstdio>
+#include <nlohmann/json.hpp>
+
+namespace orbit {
+  namespace {
+    std::string dump(const nlohmann::json &j) {
+      // Titles and names come from other programs and may hold invalid UTF-8: replace instead of throwing.
+      return j.dump(-1, ' ', false, nlohmann::json::error_handler_t::replace);
+    }
+
+    const ApiReply kOk {200, R"({"ok":true})"};
+
+    bool parse_int(const std::string &s, long long &out) {
+      if (s.empty()) {
+        return false;
+      }
+      auto [p, ec] = std::from_chars(s.data(), s.data() + s.size(), out);
+      return ec == std::errc {} && p == s.data() + s.size();
+    }
+
+    bool parse_u64(const std::string &s, uint64_t &out) {
+      if (s.empty()) {
+        return false;
+      }
+      auto [p, ec] = std::from_chars(s.data(), s.data() + s.size(), out);
+      return ec == std::errc {} && p == s.data() + s.size();
+    }
+
+    std::string lower(std::string s) {
+      std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) {
+        return static_cast<char>(std::tolower(c));
+      });
+      return s;
+    }
+  }  // namespace
+
+  std::string app_id_for_path(const std::string &path) {
+    uint64_t h = 1469598103934665603ULL;  // FNV-1a 64
+    for (unsigned char c : lower(path)) {
+      h ^= c;
+      h *= 1099511628211ULL;
+    }
+    char buf[17];
+    std::snprintf(buf, sizeof(buf), "%016llx", static_cast<unsigned long long>(h));
+    return buf;
+  }
+
+  ApiReply windows_list_reply(const crypto::named_cert_t *cert, WindowPlatform &p) {
+    if (int err = perm_error(cert, crypto::PERM::orbit_windows)) {
+      return {err, {}};
+    }
+    auto arr = nlohmann::json::array();
+    for (auto &w : p.list()) {
+      arr.push_back({{"id", w.id}, {"title", w.title}, {"process", w.process}});
+    }
+    return {200, dump({{"windows", arr}})};
+  }
+
+  ApiReply window_activate_reply(const crypto::named_cert_t *cert, WindowPlatform &p, const Query &query) {
+    if (int err = perm_error(cert, crypto::PERM::orbit_windows)) {
+      return {err, {}};
+    }
+    uint64_t id = 0;
+    auto it = query.find("id");
+    if (it == query.end() || !parse_u64(it->second, id)) {
+      return error_reply(400, "bad_request");
+    }
+    switch (p.activate(id)) {
+      case ActivateResult::ok:
+        return kOk;
+      case ActivateResult::not_found:
+        return error_reply(404, "not_found");
+      case ActivateResult::denied:
+      default:
+        return error_reply(409, "denied");
+    }
+  }
+
+  ApiReply desktop_reply(const crypto::named_cert_t *cert, WindowPlatform &p) {
+    if (int err = perm_error(cert, crypto::PERM::orbit_windows)) {
+      return {err, {}};
+    }
+    return p.show_desktop() ? kOk : error_reply(500, "failed");
+  }
+
+  ApiReply apps_list_reply(const crypto::named_cert_t *cert, WindowPlatform &p) {
+    if (int err = perm_error(cert, crypto::PERM::orbit_windows)) {
+      return {err, {}};
+    }
+    auto apps = p.start_menu();
+    std::stable_sort(apps.begin(), apps.end(), [](const AppEntry &a, const AppEntry &b) {
+      return lower(a.name) < lower(b.name);
+    });
+    auto arr = nlohmann::json::array();
+    for (auto &a : apps) {
+      arr.push_back({{"id", a.id}, {"name", a.name}});
+    }
+    return {200, dump({{"apps", arr}})};
+  }
+
+  ApiReply app_launch_reply(const crypto::named_cert_t *cert, WindowPlatform &p, const Query &query) {
+    if (int err = perm_error(cert, crypto::PERM::orbit_windows)) {
+      return {err, {}};
+    }
+    auto it = query.find("id");
+    if (it == query.end() || it->second.empty()) {
+      return error_reply(400, "bad_request");
+    }
+    auto apps = p.start_menu();
+    bool known = std::any_of(apps.begin(), apps.end(), [&](const AppEntry &a) {
+      return a.id == it->second;
+    });
+    if (!known) {
+      return error_reply(404, "not_found");
+    }
+    return p.launch(it->second) ? kOk : error_reply(500, "failed");
+  }
+
+  ApiReply volume_reply(const crypto::named_cert_t *cert, WindowPlatform &p, const Query &query) {
+    if (int err = perm_error(cert, crypto::PERM::input_kbd)) {
+      return {err, {}};
+    }
+    auto level_it = query.find("level");
+    auto mute_it = query.find("mute");
+    if (level_it == query.end() && mute_it == query.end()) {
+      return error_reply(400, "bad_request");
+    }
+
+    long long level = 0;
+    if (level_it != query.end() && !parse_int(level_it->second, level)) {
+      return error_reply(400, "bad_request");
+    }
+    if (mute_it != query.end() && mute_it->second != "0" && mute_it->second != "1") {
+      return error_reply(400, "bad_request");
+    }
+
+    bool ok = true;
+    if (level_it != query.end()) {
+      ok = p.set_volume(static_cast<int>(std::clamp<long long>(level, 0, 100))) && ok;
+    }
+    if (mute_it != query.end()) {
+      ok = p.set_mute(mute_it->second == "1") && ok;
+    }
+    return ok ? kOk : error_reply(500, "failed");
+  }
+}  // namespace orbit
