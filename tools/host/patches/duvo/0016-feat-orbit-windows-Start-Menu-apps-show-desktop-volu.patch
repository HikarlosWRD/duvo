+/**
+ * @file src/orbit/power_api.cpp
+ * @brief Power actions endpoint (platform independent part).
+ */
+#include "power_api.h"
+
+#include "src/logging.h"
+
+namespace orbit {
+  std::optional<PowerAction> parse_power_action(std::string_view s) {
+    if (s == "shutdown") {
+      return PowerAction::shutdown;
+    }
+    if (s == "restart") {
+      return PowerAction::restart;
+    }
+    if (s == "sleep") {
+      return PowerAction::sleep;
+    }
+    if (s == "logoff") {
+      return PowerAction::logoff;
+    }
+    if (s == "lock") {
+      return PowerAction::lock;
+    }
+    return std::nullopt;
+  }
+
+  const char *power_action_name(PowerAction a) {
+    switch (a) {
+      case PowerAction::shutdown:
+        return "shutdown";
+      case PowerAction::restart:
+        return "restart";
+      case PowerAction::sleep:
+        return "sleep";
+      case PowerAction::logoff:
+        return "logoff";
+      case PowerAction::lock:
+        return "lock";
+    }
+    return "?";
+  }
+
+  ApiReply power_reply(const crypto::named_cert_t *cert, PowerPlatform &p, const Query &query, const log_fn &log) {
+    if (int err = perm_error(cert, crypto::PERM::orbit_power)) {
+      return {err, {}};
+    }
+    auto it = query.find("action");
+    auto action = it == query.end() ? std::nullopt : parse_power_action(it->second);
+    if (!action) {
+      return error_reply(400, "bad_action");
+    }
+
+    // Spec §10.5: the app confirms; the host logs who asked.
+    std::string line = std::string {"[Orbit] power "} + power_action_name(*action) + " pedido por " + cert->name;
+    if (log) {
+      log(line);
+    } else {
+      BOOST_LOG(info) << line;
+    }
+
+    if (!p.run(*action)) {
+      return error_reply(500, "failed");
+    }
+    return {200, R"({"ok":true})"};
+  }
+}  // namespace orbit
