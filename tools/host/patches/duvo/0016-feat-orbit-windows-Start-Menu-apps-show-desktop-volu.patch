+/**
+ * @file tests/unit/test_power_api.cpp
+ * @brief Test src/orbit/power_api.* with a fake platform (never touches the real PC power state).
+ */
+#include "../tests_common.h"
+
+#include <src/orbit/power_api.h>
+#include <utility>
+#include <vector>
+
+namespace {
+  struct FakePower: orbit::PowerPlatform {
+    std::vector<orbit::PowerAction> ran;
+    bool result = true;
+
+    bool run(orbit::PowerAction a) override {
+      ran.push_back(a);
+      return result;
+    }
+  };
+
+  crypto::named_cert_t cert_with(crypto::PERM perm, const std::string &name = "Poco F5") {
+    crypto::named_cert_t c {};
+    c.name = name;
+    c.perm = perm;
+    return c;
+  }
+
+  orbit::log_fn sink(std::vector<std::string> &lines) {
+    return [&lines](const std::string &l) {
+      lines.push_back(l);
+    };
+  }
+}  // namespace
+
+TEST(PowerApi, InvalidActionIs400) {
+  FakePower p;
+  std::vector<std::string> log;
+  auto c = cert_with(crypto::PERM::orbit_power);
+  EXPECT_EQ(orbit::power_reply(&c, p, {{"action", "explode"}}, sink(log)).status, 400);
+  EXPECT_EQ(orbit::power_reply(&c, p, {}, sink(log)).status, 400);
+  EXPECT_EQ(orbit::power_reply(&c, p, {{"action", "Shutdown"}}, sink(log)).status, 400);
+  EXPECT_TRUE(p.ran.empty());
+
+  const std::vector<std::pair<std::string, orbit::PowerAction>> all {
+    {"shutdown", orbit::PowerAction::shutdown},
+    {"restart", orbit::PowerAction::restart},
+    {"sleep", orbit::PowerAction::sleep},
+    {"logoff", orbit::PowerAction::logoff},
+    {"lock", orbit::PowerAction::lock},
+  };
+  for (const auto &[name, action] : all) {
+    p.ran.clear();
+    EXPECT_EQ(orbit::power_reply(&c, p, {{"action", name}}, sink(log)).status, 200) << name;
+    ASSERT_EQ(p.ran.size(), 1u);
+    EXPECT_EQ(p.ran[0], action);
+  }
+
+  p.result = false;
+  EXPECT_EQ(orbit::power_reply(&c, p, {{"action", "lock"}}, sink(log)).status, 500);
+}
+
+TEST(PowerApi, RequiresOrbitPowerPerm) {
+  FakePower p;
+  std::vector<std::string> log;
+  auto c = cert_with(static_cast<crypto::PERM>(static_cast<uint32_t>(crypto::PERM::_all) & ~static_cast<uint32_t>(crypto::PERM::orbit_power)));
+  EXPECT_EQ(orbit::power_reply(&c, p, {{"action", "shutdown"}}, sink(log)).status, 403);
+  EXPECT_EQ(orbit::power_reply(nullptr, p, {{"action", "shutdown"}}, sink(log)).status, 401);
+  EXPECT_TRUE(p.ran.empty());
+  EXPECT_TRUE(log.empty());
+}
+
+TEST(PowerApi, LogsDeviceName) {
+  FakePower p;
+  std::vector<std::string> log;
+  auto c = cert_with(crypto::PERM::orbit_power, "TL10 da sala");
+  EXPECT_EQ(orbit::power_reply(&c, p, {{"action", "sleep"}}, sink(log)).status, 200);
+  ASSERT_EQ(log.size(), 1u);
+  EXPECT_EQ(log[0], "[Orbit] power sleep pedido por TL10 da sala");
+}
