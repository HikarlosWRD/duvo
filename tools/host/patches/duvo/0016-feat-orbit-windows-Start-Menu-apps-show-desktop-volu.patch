+/**
+ * @file src/orbit/platform_windows_win.cpp
+ * @brief Windows WindowPlatform (windows, Start Menu, show desktop, volume) and PowerPlatform.
+ *
+ * User context: the host may run as SYSTEM inside the user's session (Apollo service) or as the user.
+ * - Window list/activate/show desktop run on a short-lived thread attached to the input desktop
+ *   (platf::syncThreadDesktop, as Apollo's input code does), so they work in both cases.
+ * - Start Menu: the all-users folder plus the logged-in user's folder (resolved with the user's token when
+ *   running as SYSTEM). Shortcuts are opened with `explorer.exe "<lnk>"` through platf::run_command, which
+ *   already starts processes as the logged-in user when the host is SYSTEM. No extra helper is needed.
+ * - Lock as SYSTEM: `rundll32.exe user32.dll,LockWorkStation` via the same run_command path
+ *   (LockWorkStation only works from the user's interactive session). Logoff as SYSTEM: WTSLogoffSession.
+ * Nothing here throws; failures are logged and reported as false / denied.
+ */
+#define BOOST_PROCESS_VERSION 1
+#include "power_api.h"
+#include "windows_api.h"
+
+#include <boost/filesystem.hpp>
+#include <boost/process/v1/child.hpp>
+#include <boost/process/v1/environment.hpp>
+
+// clang-format off
+#include <WinSock2.h>
+#include <Windows.h>
+#include <dwmapi.h>
+#include <endpointvolume.h>
+#include <mmdeviceapi.h>
+#include <shldisp.h>
+#include <ShlObj.h>
+#include <WtsApi32.h>
+// clang-format on
+
+#include "src/logging.h"
+#include "src/platform/common.h"
+#include "src/platform/windows/misc.h"
+
+#include <algorithm>
+#include <chrono>
+#include <filesystem>
+#include <functional>
+#include <system_error>
+#include <thread>
+
+using namespace std::literals;
+
+namespace platf {
+  // Defined in src/platform/windows/misc.cpp (not exported by a header).
+  HANDLE retrieve_users_token(bool elevated);
+  bool is_running_as_system();
+}  // namespace platf
+
+namespace orbit {
+  namespace {
+    // shldisp.h declares these GUIDs without a definition in the import libraries we link.
+    const CLSID kClsidShell = {0x13709620, 0xc279, 0x11ce, {0xa4, 0x9e, 0x44, 0x45, 0x53, 0x54, 0x00, 0x00}};
+    const IID kIidShellDispatch4 = {0xefd84b2d, 0x4bcf, 0x4298, {0xbe, 0x25, 0xeb, 0x54, 0x2a, 0x59, 0xfb, 0xda}};
+
+    /// Run fn on a fresh thread bound to the input desktop (keeps the HTTP thread's desktop/COM state untouched).
+    template<class T>
+    T on_input_desktop(std::function<T()> fn) {
+      T result {};
+      std::thread t([&]() {
+        platf::syncThreadDesktop();
+        result = fn();
+      });
+      t.join();
+      return result;
+    }
+
+    std::string process_name(DWORD pid) {
+      HANDLE proc = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+      if (proc == nullptr) {
+        return {};
+      }
+      wchar_t path[MAX_PATH * 2];
+      DWORD size = static_cast<DWORD>(std::size(path));
+      std::string out;
+      if (QueryFullProcessImageNameW(proc, 0, path, &size) && size > 0) {
+        std::wstring_view full {path, size};
+        auto slash = full.find_last_of(L"\\/");
+        out = platf::to_utf8(slash == std::wstring_view::npos ? full : full.substr(slash + 1));
+      }
+      CloseHandle(proc);
+      return out;
+    }
+
+    /// Mandatory integrity level RID of a process token, or -1 when it can't be read.
+    long integrity_of_process(HANDLE proc) {
+      HANDLE token = nullptr;
+      if (!OpenProcessToken(proc, TOKEN_QUERY, &token)) {
+        return -1;
+      }
+      long rid = -1;
+      DWORD size = 0;
+      GetTokenInformation(token, TokenIntegrityLevel, nullptr, 0, &size);
+      if (size > 0) {
+        std::vector<BYTE> buf(size);
+        if (GetTokenInformation(token, TokenIntegrityLevel, buf.data(), size, &size)) {
+          auto label = reinterpret_cast<TOKEN_MANDATORY_LABEL *>(buf.data());
+          auto count = *GetSidSubAuthorityCount(label->Label.Sid);
+          if (count > 0) {
+            rid = static_cast<long>(*GetSidSubAuthority(label->Label.Sid, count - 1));
+          }
+        }
+      }
+      CloseHandle(token);
+      return rid;
+    }
+
+    /// True when the window's process runs at a higher integrity level than the host (e.g. elevated admin app).
+    bool higher_integrity(HWND hwnd) {
+      DWORD pid = 0;
+      GetWindowThreadProcessId(hwnd, &pid);
+      HANDLE proc = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+      if (proc == nullptr) {
+        // Can't even query it: treat as protected.
+        return true;
+      }
+      long target = integrity_of_process(proc);
+      CloseHandle(proc);
+      long self = integrity_of_process(GetCurrentProcess());
+      // Unknown target level: let SetForegroundWindow decide.
+      return target >= 0 && self >= 0 && target > self;
+    }
+
+    bool is_shell_desktop_window(HWND hwnd) {
+      wchar_t cls[64];
+      int n = GetClassNameW(hwnd, cls, static_cast<int>(std::size(cls)));
+      std::wstring_view c {cls, static_cast<size_t>(n > 0 ? n : 0)};
+      return c == L"Progman" || c == L"WorkerW";
+    }
+
+    struct EnumCtx {
+      std::vector<WindowInfo> out;
+      DWORD self;
+    };
+
+    BOOL CALLBACK enum_window(HWND hwnd, LPARAM lp) {
+      auto ctx = reinterpret_cast<EnumCtx *>(lp);
+      if (!IsWindowVisible(hwnd)) {
+        return TRUE;
+      }
+      if (GetWindowLongW(hwnd, GWL_EXSTYLE) & WS_EX_TOOLWINDOW) {
+        return TRUE;
+      }
+      DWORD cloaked = 0;
+      if (SUCCEEDED(DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, &cloaked, sizeof(cloaked))) && cloaked != 0) {
+        return TRUE;
+      }
+      DWORD pid = 0;
+      GetWindowThreadProcessId(hwnd, &pid);
+      if (pid == ctx->self || is_shell_desktop_window(hwnd)) {
+        return TRUE;
+      }
+      wchar_t title[512];
+      int len = GetWindowTextW(hwnd, title, static_cast<int>(std::size(title)));
+      if (len <= 0) {
+        return TRUE;
+      }
+      ctx->out.push_back({static_cast<uint64_t>(reinterpret_cast<uintptr_t>(hwnd)), platf::to_utf8(std::wstring_view {title, static_cast<size_t>(len)}), process_name(pid)});
+      return TRUE;
+    }
+
+    bool send_win_d() {
+      INPUT in[4] {};
+      for (auto &i : in) {
+        i.type = INPUT_KEYBOARD;
+      }
+      in[0].ki.wVk = VK_LWIN;
+      in[1].ki.wVk = 'D';
+      in[2].ki.wVk = 'D';
+      in[2].ki.dwFlags = KEYEVENTF_KEYUP;
+      in[3].ki.wVk = VK_LWIN;
+      in[3].ki.dwFlags = KEYEVENTF_KEYUP;
+      return SendInput(4, in, sizeof(INPUT)) == 4;
+    }
+
+    /// Start a command as the logged-in user (Apollo's run_command handles the SYSTEM case) and detach.
+    bool run_as_user(const std::string &cmd) {
+      boost::filesystem::path working_dir;
+      auto env = boost::this_process::environment();
+      std::error_code ec;
+      auto child = platf::run_command(false, false, cmd, working_dir, env, nullptr, ec, nullptr);
+      if (ec) {
+        BOOST_LOG(warning) << "[Orbit] failed to run ["sv << cmd << "]: "sv << ec.message();
+        return false;
+      }
+      child.detach();
+      return true;
+    }
+
+    std::wstring known_folder(REFKNOWNFOLDERID id, HANDLE token) {
+      PWSTR p = nullptr;
+      std::wstring out;
+      if (SUCCEEDED(SHGetKnownFolderPath(id, 0, token, &p)) && p) {
+        out = p;
+      }
+      CoTaskMemFree(p);
+      return out;
+    }
+
+    void collect_links(const std::wstring &root, std::vector<AppEntry> &out) {
+      if (root.empty()) {
+        return;
+      }
+      std::error_code ec;
+      std::filesystem::recursive_directory_iterator it {root, std::filesystem::directory_options::skip_permission_denied, ec};
+      for (; !ec && it != std::filesystem::recursive_directory_iterator {}; it.increment(ec)) {
+        const auto &path = it->path();
+        std::error_code fec;
+        if (!it->is_regular_file(fec)) {
+          continue;
+        }
+        auto ext = path.extension().wstring();
+        if (_wcsicmp(ext.c_str(), L".lnk") != 0) {
+          continue;
+        }
+        auto full = platf::to_utf8(path.wstring());
+        out.push_back({app_id_for_path(full), platf::to_utf8(path.stem().wstring()), full});
+      }
+    }
+
+    /// Default render endpoint volume control (caller holds COM).
+    template<class Fn>
+    bool with_endpoint_volume(Fn fn) {
+      HRESULT init = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+      IMMDeviceEnumerator *enumerator = nullptr;
+      IMMDevice *device = nullptr;
+      IAudioEndpointVolume *endpoint = nullptr;
+      bool ok = false;
+      if (SUCCEEDED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, __uuidof(IMMDeviceEnumerator), reinterpret_cast<void **>(&enumerator))) &&
+          SUCCEEDED(enumerator->GetDefaultAudioEndpoint(eRender, eConsole, &device)) &&
+          SUCCEEDED(device->Activate(__uuidof(IAudioEndpointVolume), CLSCTX_ALL, nullptr, reinterpret_cast<void **>(&endpoint)))) {
+        ok = SUCCEEDED(fn(endpoint));
+      }
+      if (endpoint) {
+        endpoint->Release();
+      }
+      if (device) {
+        device->Release();
+      }
+      if (enumerator) {
+        enumerator->Release();
+      }
+      if (SUCCEEDED(init)) {
+        CoUninitialize();
+      }
+      return ok;
+    }
+
+    class WinWindowPlatform: public WindowPlatform {
+    public:
+      std::vector<WindowInfo> list() override {
+        return on_input_desktop<std::vector<WindowInfo>>([]() {
+          EnumCtx ctx {{}, GetCurrentProcessId()};
+          EnumWindows(&enum_window, reinterpret_cast<LPARAM>(&ctx));
+          return ctx.out;
+        });
+      }
+
+      ActivateResult activate(uint64_t id) override {
+        return on_input_desktop<ActivateResult>([id]() {
+          HWND hwnd = reinterpret_cast<HWND>(static_cast<uintptr_t>(id));
+          if (id == 0 || !IsWindow(hwnd)) {
+            return ActivateResult::not_found;
+          }
+          if (higher_integrity(hwnd)) {
+            return ActivateResult::denied;
+          }
+          if (IsIconic(hwnd)) {
+            // Async: a hung target must not block the API thread.
+            ShowWindowAsync(hwnd, SW_RESTORE);
+            for (int i = 0; i < 20 && IsIconic(hwnd); ++i) {
+              std::this_thread::sleep_for(10ms);
+            }
+          }
+          if (SetForegroundWindow(hwnd)) {
+            return ActivateResult::ok;
+          }
+          // Foreground lock: Windows only lets the process that got the last input event switch windows.
+          // An empty (zero-move) mouse input makes us that process; harmless for the current app.
+          INPUT in {};
+          in.type = INPUT_MOUSE;
+          SendInput(1, &in, sizeof(in));
+          if (SetForegroundWindow(hwnd)) {
+            return ActivateResult::ok;
+          }
+          BOOST_LOG(info) << "[Orbit] SetForegroundWindow refused for window "sv << id;
+          return ActivateResult::denied;
+        });
+      }
+
+      bool show_desktop() override {
+        return on_input_desktop<bool>([]() {
+          // Same as Win+D: IShellDispatch4::ToggleDesktop (needs an STA), keyboard fallback.
+          bool ok = false;
+          HRESULT init = CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED);
+          IShellDispatch4 *shell = nullptr;
+          if (SUCCEEDED(CoCreateInstance(kClsidShell, nullptr, CLSCTX_INPROC_SERVER, kIidShellDispatch4, reinterpret_cast<void **>(&shell))) && shell) {
+            ok = SUCCEEDED(shell->ToggleDesktop());
+            shell->Release();
+          }
+          if (SUCCEEDED(init)) {
+            CoUninitialize();
+          }
+          return ok || send_win_d();
+        });
+      }
+
+      std::vector<AppEntry> start_menu() override {
+        std::vector<AppEntry> out;
+        collect_links(known_folder(FOLDERID_CommonPrograms, nullptr), out);
+
+        HANDLE token = nullptr;
+        bool system = platf::is_running_as_system();
+        if (system) {
+          token = platf::retrieve_users_token(false);
+        }
+        // As SYSTEM without a user token, skip the per-user folder rather than listing SYSTEM's own profile.
+        if (!system || token) {
+          collect_links(known_folder(FOLDERID_Programs, token), out);
+        }
+        if (token) {
+          CloseHandle(token);
+        }
+        return out;
+      }
+
+      bool launch(const std::string &id) override {
+        for (auto &a : start_menu()) {
+          if (a.id == id) {
+            BOOST_LOG(info) << "[Orbit] launching Start Menu shortcut ["sv << a.name << ']';
+            return run_as_user("explorer.exe \"" + a.path + "\"");
+          }
+        }
+        return false;
+      }
+
+      bool set_volume(int level) override {
+        float scalar = static_cast<float>(std::clamp(level, 0, 100)) / 100.0f;
+        return with_endpoint_volume([scalar](IAudioEndpointVolume *ep) {
+          return ep->SetMasterVolumeLevelScalar(scalar, nullptr);
+        });
+      }
+
+      bool set_mute(bool mute) override {
+        return with_endpoint_volume([mute](IAudioEndpointVolume *ep) {
+          return ep->SetMute(mute ? TRUE : FALSE, nullptr);
+        });
+      }
+    };
+
+    bool enable_shutdown_privilege() {
+      HANDLE token = nullptr;
+      if (!OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &token)) {
+        return false;
+      }
+      TOKEN_PRIVILEGES tp {};
+      tp.PrivilegeCount = 1;
+      tp.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+      bool ok = LookupPrivilegeValueW(nullptr, L"SeShutdownPrivilege", &tp.Privileges[0].Luid) &&
+                AdjustTokenPrivileges(token, FALSE, &tp, 0, nullptr, nullptr) && GetLastError() == ERROR_SUCCESS;
+      CloseHandle(token);
+      return ok;
+    }
+
+    constexpr DWORD kShutdownReason = SHTDN_REASON_MAJOR_OTHER | SHTDN_REASON_MINOR_OTHER | SHTDN_REASON_FLAG_PLANNED;
+
+    class WinPowerPlatform: public PowerPlatform {
+    public:
+      bool run(PowerAction action) override {
+        bool ok = false;
+        switch (action) {
+          case PowerAction::shutdown:
+          case PowerAction::restart:
+            // Apps are not forced closed: one with unsaved work can still cancel.
+            ok = enable_shutdown_privilege() &&
+                 InitiateSystemShutdownExW(nullptr, nullptr, 0, FALSE, action == PowerAction::restart, kShutdownReason);
+            break;
+          case PowerAction::sleep:
+            ok = sleep();
+            break;
+          case PowerAction::logoff:
+            ok = platf::is_running_as_system() ? WTSLogoffSession(WTS_CURRENT_SERVER_HANDLE, WTSGetActiveConsoleSessionId(), FALSE) : ExitWindowsEx(EWX_LOGOFF, kShutdownReason);
+            break;
+          case PowerAction::lock:
+            ok = platf::is_running_as_system() ? run_as_user("rundll32.exe user32.dll,LockWorkStation") : LockWorkStation();
+            break;
+        }
+        if (!ok) {
+          BOOST_LOG(warning) << "[Orbit] power "sv << power_action_name(action) << " failed: "sv << GetLastError();
+        }
+        return ok;
+      }
+
+    private:
+      using set_suspend_state_fn = BOOLEAN(WINAPI *)(BOOLEAN, BOOLEAN, BOOLEAN);
+
+      static bool sleep() {
+        // powrprof is loaded on demand (not in the link line). SetSuspendState blocks until resume, so it runs
+        // shortly after on a detached thread and the HTTP reply goes out first.
+        HMODULE lib = LoadLibraryExW(L"powrprof.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+        if (!lib) {
+          return false;
+        }
+        auto fn = reinterpret_cast<set_suspend_state_fn>(reinterpret_cast<void *>(GetProcAddress(lib, "SetSuspendState")));
+        if (!fn || !enable_shutdown_privilege()) {
+          FreeLibrary(lib);
+          return false;
+        }
+        std::thread([lib, fn]() {
+          std::this_thread::sleep_for(500ms);
+          if (!fn(FALSE, FALSE, FALSE)) {
+            BOOST_LOG(warning) << "[Orbit] SetSuspendState failed: "sv << GetLastError();
+          }
+          FreeLibrary(lib);
+        }).detach();
+        return true;
+      }
+    };
+  }  // namespace
+
+  std::shared_ptr<WindowPlatform> make_platform_windows() {
+    return std::make_shared<WinWindowPlatform>();
+  }
+
+  std::shared_ptr<PowerPlatform> make_platform_power() {
+    return std::make_shared<WinPowerPlatform>();
+  }
+}  // namespace orbit
