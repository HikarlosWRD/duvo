+  /**
+   * @brief ORBIT: serve the Duvo images (logo, favicon) so they also load on the login page.
+   */
+  void getDuvoImage(resp_https_t response, req_https_t request) {
+    print_req(request);
+    std::string name = request->path.substr(std::string("/images/").size());
+    std::string type = "image/png";
+    if (name.size() > 4 && name.compare(name.size() - 4, 4, ".svg") == 0) {
+      type = "image/svg+xml";
+    } else if (name.size() > 4 && name.compare(name.size() - 4, 4, ".ico") == 0) {
+      type = "image/x-icon";
+    }
+    std::ifstream in(std::string(WEB_DIR "images/") + name, std::ios::binary);
+    if (!in) {
+      not_found(response, request);
+      return;
+    }
+    SimpleWeb::CaseInsensitiveMultimap headers;
+    headers.emplace("Content-Type", type);
+    headers.emplace("X-Frame-Options", "DENY");
+    headers.emplace("Content-Security-Policy", "frame-ancestors 'none';");
+    response->write(SimpleWeb::StatusCode::success_ok, in, headers);
+  }
+
   /**
    * @brief Check if a path is a child of another path.
    * @param base The base path.
@@ -1678,6 +1702,7 @@ namespace confighttp {
     server.resource["^/api/covers/upload$"]["POST"] = uploadCover;
     server.resource["^/images/apollo.ico$"]["GET"] = getFaviconImage;
     server.resource["^/images/logo-apollo-45.png$"]["GET"] = getApolloLogoImage;
+    server.resource["^/images/duvo[A-Za-z0-9_-]*\\.(png|svg|ico)$"]["GET"] = getDuvoImage;  // ORBIT:
     server.resource["^/assets\\/.+$"]["GET"] = getNodeModules;
