+
+/* Device rows (concept): icon, name and status, access levels as a segmented control, quiet actions. */
+html .duvo-device { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; padding: 16px 22px; }
+html .duvo-device-icon { width: 40px; height: 40px; border-radius: 12px; background: var(--bs-secondary-bg); display: flex; align-items: center; justify-content: center; flex: 0 0 40px; }
+html .duvo-device-name { display: flex; flex-direction: column; flex: 1 1 160px; min-width: 0; }
+html .duvo-segmented { display: flex; gap: 4px; padding: 4px; border-radius: 14px; background: var(--bs-body-bg); border: 1px solid var(--bs-border-color); }
+html .duvo-segmented button, html .duvo-segmented span { height: 36px; padding: 0 12px; border-radius: 10px; border: none; background: transparent; color: var(--bs-secondary-color); font-size: 13px; display: inline-flex; align-items: center; }
+html .duvo-segmented .on { background: #f2851f; color: #1a1204; font-weight: 600; }
+html .duvo-device-actions { display: flex; gap: 6px; }
