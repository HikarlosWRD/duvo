+  ApiReply app_icon_reply(const crypto::named_cert_t *cert, WindowPlatform &p, const Query &query) {
+    if (int err = perm_error(cert, crypto::PERM::orbit_windows)) {
+      return {err, {}};
+    }
+    auto it = query.find("id");
+    if (it == query.end() || it->second.empty()) {
+      return error_reply(400, "bad_request");
+    }
+    static std::mutex mutex;
+    static std::map<std::string, std::string> cache;  // id -> base64 PNG (empty = no icon)
+    {
+      std::lock_guard lock(mutex);
+      auto c = cache.find(it->second);
+      if (c != cache.end()) {
+        return c->second.empty() ? error_reply(404, "not_found") : ApiReply {200, dump({{"png", c->second}})};
+      }
+    }
+    auto png = p.app_icon(it->second);
+    std::string b64 = png.empty() ? std::string {} : base64_encode(png);
+    {
+      std::lock_guard lock(mutex);
+      if (cache.size() < 2000) {
+        cache[it->second] = b64;
+      }
+    }
+    return b64.empty() ? error_reply(404, "not_found") : ApiReply {200, dump({{"png", b64}})};
+  }
+
