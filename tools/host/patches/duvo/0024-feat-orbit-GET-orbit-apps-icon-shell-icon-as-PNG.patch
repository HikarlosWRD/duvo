@@ -155,6 +157,33 @@ namespace orbit {
       return result;
     }
 
+    std::vector<unsigned char> icon_png_sta(const std::wstring &path, int px) {
+      Com<IShellItemImageFactory> factory;
+      if (FAILED(SHCreateItemFromParsingName(path.c_str(), nullptr, IID_PPV_ARGS(&factory)))) {
+        return {};
+      }
+      HBITMAP bmp = nullptr;
+      SIZE size {px, px};
+      if (FAILED(factory->GetImage(size, SIIGBF_ICONONLY | SIIGBF_BIGGERSIZEOK, &bmp)) || !bmp) {
+        return {};
+      }
+      std::vector<unsigned char> out;
+      Com<IWICImagingFactory> f;
+      Com<IWICBitmap> wic;
+      Com<IStream> stream;
+      Com<IWICBitmapEncoder> enc;
+      Com<IWICBitmapFrameEncode> frame;
+      if (SUCCEEDED(CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&f))) &&
+          SUCCEEDED(f->CreateBitmapFromHBITMAP(bmp, nullptr, WICBitmapUseAlpha, &wic)) && SUCCEEDED(CreateStreamOnHGlobal(nullptr, TRUE, &stream)) &&
+          SUCCEEDED(f->CreateEncoder(GUID_ContainerFormatPng, nullptr, &enc)) && SUCCEEDED(enc->Initialize(stream.p, WICBitmapEncoderNoCache)) &&
+          SUCCEEDED(enc->CreateNewFrame(&frame, nullptr)) && SUCCEEDED(frame->Initialize(nullptr)) && SUCCEEDED(frame->WriteSource(wic.p, nullptr)) &&
+          SUCCEEDED(frame->Commit()) && SUCCEEDED(enc->Commit())) {
+        out = stream_bytes(stream.p);
+      }
+      DeleteObject(bmp);
+      return out;
+    }
+
     class WinClipboardImage: public ClipboardImagePlatform {
     public:
       std::optional<std::vector<unsigned char>> get_png() override {
@@ -233,4 +262,13 @@ namespace orbit {
   std::shared_ptr<ClipboardImagePlatform> make_platform_clipboard_image() {
     return std::make_shared<WinClipboardImage>();
   }
+  std::vector<unsigned char> shell_icon_png(const std::string &path_utf8, int px) {
+    int n = MultiByteToWideChar(CP_UTF8, 0, path_utf8.c_str(), -1, nullptr, 0);
+    if (n <= 1) {
+      return {};
+    }
+    std::wstring w(static_cast<size_t>(n - 1), L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, path_utf8.c_str(), -1, w.data(), n);
+    return on_sta([&] { return icon_png_sta(w, px); });
+  }
 }  // namespace orbit
