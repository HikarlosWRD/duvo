+/**
+ * @file src/orbit/clipboard_image.cpp
+ * @brief Image clipboard endpoints (platform independent part).
+ */
+#include "clipboard_image.h"
+
+#include <nlohmann/json.hpp>
+#include <openssl/evp.h>
+
+namespace orbit {
+  std::string base64_encode(const std::vector<unsigned char> &data) {
+    if (data.empty()) {
+      return {};
+    }
+    std::string out(4 * ((data.size() + 2) / 3), '\0');
+    int n = EVP_EncodeBlock(reinterpret_cast<unsigned char *>(out.data()), data.data(), static_cast<int>(data.size()));
+    out.resize(n < 0 ? 0 : static_cast<std::size_t>(n));
+    return out;
+  }
+
+  std::optional<std::vector<unsigned char>> base64_decode(const std::string &text) {
+    std::string s;
+    s.reserve(text.size());
+    for (char c : text) {
+      if (c != '\r' && c != '\n' && c != ' ') {
+        s.push_back(c);
+      }
+    }
+    if (s.size() % 4 != 0) {
+      return std::nullopt;
+    }
+    if (s.empty()) {
+      return std::vector<unsigned char> {};
+    }
+    std::vector<unsigned char> out(s.size() / 4 * 3);
+    int n = EVP_DecodeBlock(out.data(), reinterpret_cast<const unsigned char *>(s.data()), static_cast<int>(s.size()));
+    if (n < 0) {
+      return std::nullopt;
+    }
+    std::size_t pad = (s.size() >= 1 && s.back() == '=') + (s.size() >= 2 && s[s.size() - 2] == '=');
+    out.resize(static_cast<std::size_t>(n) - pad);
+    return out;
+  }
+
+  ApiReply clipboard_image_get_reply(const crypto::named_cert_t *cert, ClipboardImagePlatform &p) {
+    if (int e = perm_error(cert, crypto::PERM::clipboard_read)) {
+      return {e, {}};
+    }
+    auto png = p.get_png();
+    if (!png || png->empty()) {
+      return {204, {}};
+    }
+    if (png->size() > kMaxClipboardImageBytes) {
+      return error_reply(413, "too_large");
+    }
+    return {200, nlohmann::json {{"png", base64_encode(*png)}}.dump()};
+  }
+
+  ApiReply clipboard_image_set_reply(const crypto::named_cert_t *cert, ClipboardImagePlatform &p, const std::string &body) {
+    if (int e = perm_error(cert, crypto::PERM::clipboard_set)) {
+      return {e, {}};
+    }
+    // Reject absurd bodies before parsing (base64 of 10 MB is ~13.4 MB).
+    if (body.size() > kMaxClipboardImageBytes / 3 * 4 + 4096) {
+      return error_reply(413, "too_large");
+    }
+    auto j = nlohmann::json::parse(body, nullptr, false);
+    if (j.is_discarded() || !j.is_object() || !j.contains("png") || !j["png"].is_string()) {
+      return error_reply(400, "bad_body");
+    }
+    auto png = base64_decode(j["png"].get<std::string>());
+    if (!png || png->empty()) {
+      return error_reply(400, "bad_png");
+    }
+    if (png->size() > kMaxClipboardImageBytes) {
+      return error_reply(413, "too_large");
+    }
+    if (!p.set_png(*png)) {
+      return error_reply(500, "clipboard_failed");
+    }
+    return {200, R"({"ok":true})"};
+  }
+}  // namespace orbit
