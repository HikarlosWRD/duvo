+/**
+ * @file tests/unit/test_clipboard_image.cpp
+ * @brief Test src/orbit/clipboard_image.* with a fake clipboard.
+ */
+#include "../tests_common.h"
+
+#include <src/orbit/clipboard_image.h>
+
+namespace {
+  struct FakeClip: orbit::ClipboardImagePlatform {
+    std::optional<std::vector<unsigned char>> current;
+    std::vector<unsigned char> written;
+    bool ok = true;
+
+    std::optional<std::vector<unsigned char>> get_png() override {
+      return current;
+    }
+
+    bool set_png(const std::vector<unsigned char> &png) override {
+      written = png;
+      return ok;
+    }
+  };
+
+  crypto::named_cert_t cert_with(crypto::PERM perm) {
+    crypto::named_cert_t c {};
+    c.name = "Poco F6";
+    c.uuid = "u1";
+    c.perm = perm;
+    return c;
+  }
+
+  const auto kBoth = static_cast<crypto::PERM>(static_cast<uint32_t>(crypto::PERM::clipboard_read) | static_cast<uint32_t>(crypto::PERM::clipboard_set));
+}  // namespace
+
+TEST(ClipboardImage, Base64RoundTrip) {
+  for (std::vector<unsigned char> v : {std::vector<unsigned char> {1}, {1, 2}, {1, 2, 3}, {0, 255, 128, 7, 9}}) {
+    auto d = orbit::base64_decode(orbit::base64_encode(v));
+    ASSERT_TRUE(d.has_value());
+    EXPECT_EQ(*d, v);
+  }
+  EXPECT_FALSE(orbit::base64_decode("abc").has_value());
+}
+
+TEST(ClipboardImage, EmptyIs204) {
+  FakeClip p;
+  auto c = cert_with(kBoth);
+  EXPECT_EQ(orbit::clipboard_image_get_reply(&c, p).status, 204);
+}
+
+TEST(ClipboardImage, RoundTripPng) {
+  FakeClip p;
+  auto c = cert_with(kBoth);
+  p.current = std::vector<unsigned char> {0x89, 'P', 'N', 'G', 1, 2, 3};
+  auto r = orbit::clipboard_image_get_reply(&c, p);
+  ASSERT_EQ(r.status, 200);
+  auto set = orbit::clipboard_image_set_reply(&c, p, r.body);
+  EXPECT_EQ(set.status, 200);
+  EXPECT_EQ(p.written, *p.current);
+}
+
+TEST(ClipboardImage, RejectsOver10MB) {
+  FakeClip p;
+  auto c = cert_with(kBoth);
+  p.current = std::vector<unsigned char>(orbit::kMaxClipboardImageBytes + 1, 7);
+  EXPECT_EQ(orbit::clipboard_image_get_reply(&c, p).status, 413);
+  std::string body = std::string(R"({"png":")") + orbit::base64_encode(*p.current) + "\"}";
+  EXPECT_EQ(orbit::clipboard_image_set_reply(&c, p, body).status, 413);
+  EXPECT_TRUE(p.written.empty());
+}
+
+TEST(ClipboardImage, BadBodyIs400) {
+  FakeClip p;
+  auto c = cert_with(kBoth);
+  EXPECT_EQ(orbit::clipboard_image_set_reply(&c, p, "nope").status, 400);
+  EXPECT_EQ(orbit::clipboard_image_set_reply(&c, p, R"({"png":"abc"})").status, 400);
+}
+
+TEST(ClipboardImage, PermsChecked) {
+  FakeClip p;
+  p.current = std::vector<unsigned char> {1, 2, 3};
+  auto none = cert_with(crypto::PERM::view);
+  EXPECT_EQ(orbit::clipboard_image_get_reply(&none, p).status, 403);
+  EXPECT_EQ(orbit::clipboard_image_set_reply(&none, p, R"({"png":"AQID"})").status, 403);
+  EXPECT_EQ(orbit::clipboard_image_get_reply(nullptr, p).status, 401);
+  auto read_only = cert_with(crypto::PERM::clipboard_read);
+  EXPECT_EQ(orbit::clipboard_image_get_reply(&read_only, p).status, 200);
+  EXPECT_EQ(orbit::clipboard_image_set_reply(&read_only, p, R"({"png":"AQID"})").status, 403);
+}
