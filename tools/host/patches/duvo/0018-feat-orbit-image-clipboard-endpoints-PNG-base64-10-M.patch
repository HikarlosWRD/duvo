+/**
+ * @file src/orbit/clipboard_image.h
+ * @brief Image clipboard endpoints (/orbit/clipboard?type=image), PNG base64 in JSON.
+ */
+#pragma once
+
+#include "api_reply.h"
+
+#include <cstddef>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace orbit {
+  /// Decoded PNG size limit (spec: 10 MB).
+  inline constexpr std::size_t kMaxClipboardImageBytes = 10u * 1024u * 1024u;
+
+  /// Windows clipboard access for images (PNG bytes). Fakes in tests.
+  class ClipboardImagePlatform {
+  public:
+    virtual ~ClipboardImagePlatform() = default;
+    /// PNG of the current clipboard image, or nullopt when the clipboard has no image.
+    virtual std::optional<std::vector<unsigned char>> get_png() = 0;
+    /// Put a PNG on the clipboard (as PNG and as a bitmap). False on failure.
+    virtual bool set_png(const std::vector<unsigned char> &png) = 0;
+  };
+
+  std::string base64_encode(const std::vector<unsigned char> &data);
+  /// nullopt for invalid base64.
+  std::optional<std::vector<unsigned char>> base64_decode(const std::string &text);
+
+  /// GET: 401/403 (clipboard_read), 204 without image, 413 if larger than the limit, 200 {"png": base64}.
+  ApiReply clipboard_image_get_reply(const crypto::named_cert_t *cert, ClipboardImagePlatform &p);
+  /// POST body {"png": base64}: 401/403 (clipboard_set), 400 bad body, 413 over the limit, 500 on failure, 200.
+  ApiReply clipboard_image_set_reply(const crypto::named_cert_t *cert, ClipboardImagePlatform &p, const std::string &body);
+
+  std::shared_ptr<ClipboardImagePlatform> make_platform_clipboard_image();
+}  // namespace orbit
diff --git a/src/orbit/clipboard_image_win.cpp b/src/orbit/clipboard_image_win.cpp
new file mode 100644
index 00000000..ada7e7bb
--- /dev/null
+++ b/src/orbit/clipboard_image_win.cpp
@@ -0,0 +1,236 @@
+/*
