+/**
+ * @file src/orbit/clipboard_image_win.cpp
+ * @brief Windows image clipboard: reads the registered "PNG" format or a bitmap (encoded with WIC); writes PNG + CF_DIB.
+ */
+// clang-format off
+#include <windows.h>
+#include <objidl.h>
+#include <wincodec.h>
+// clang-format on
+
+#include "clipboard_image.h"
+
+#include <cstring>
+#include <thread>
+
+namespace orbit {
+  namespace {
+    template<class T>
+    struct Com {
+      T *p = nullptr;
+      ~Com() {
+        if (p) {
+          p->Release();
+        }
+      }
+      T **operator&() {
+        return &p;
+      }
+      T *operator->() const {
+        return p;
+      }
+    };
+
+    struct Clip {
+      bool open = false;
+      Clip() {
+        for (int i = 0; i < 10 && !open; ++i) {
+          open = OpenClipboard(nullptr);
+          if (!open) {
+            Sleep(20);
+          }
+        }
+      }
+      ~Clip() {
+        if (open) {
+          CloseClipboard();
+        }
+      }
+    };
+
+    std::vector<unsigned char> stream_bytes(IStream *stream) {
+      std::vector<unsigned char> out;
+      HGLOBAL h = nullptr;
+      if (FAILED(GetHGlobalFromStream(stream, &h))) {
+        return out;
+      }
+      STATSTG st {};
+      if (FAILED(stream->Stat(&st, STATFLAG_NONAME))) {
+        return out;
+      }
+      auto *data = static_cast<unsigned char *>(GlobalLock(h));
+      if (data) {
+        out.assign(data, data + st.cbSize.QuadPart);
+        GlobalUnlock(h);
+      }
+      return out;
+    }
+
+    std::optional<std::vector<unsigned char>> png_from_hbitmap(HBITMAP bmp) {
+      Com<IWICImagingFactory> f;
+      if (FAILED(CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&f)))) {
+        return std::nullopt;
+      }
+      Com<IWICBitmap> wic;
+      if (FAILED(f->CreateBitmapFromHBITMAP(bmp, nullptr, WICBitmapIgnoreAlpha, &wic))) {
+        return std::nullopt;
+      }
+      Com<IStream> stream;
+      if (FAILED(CreateStreamOnHGlobal(nullptr, TRUE, &stream))) {
+        return std::nullopt;
+      }
+      Com<IWICBitmapEncoder> enc;
+      Com<IWICBitmapFrameEncode> frame;
+      if (FAILED(f->CreateEncoder(GUID_ContainerFormatPng, nullptr, &enc)) || FAILED(enc->Initialize(stream.p, WICBitmapEncoderNoCache)) ||
+          FAILED(enc->CreateNewFrame(&frame, nullptr)) || FAILED(frame->Initialize(nullptr)) || FAILED(frame->WriteSource(wic.p, nullptr)) ||
+          FAILED(frame->Commit()) || FAILED(enc->Commit())) {
+        return std::nullopt;
+      }
+      return stream_bytes(stream.p);
+    }
+
+    /// Decode PNG to top-down 32bpp BGRA. Returns width/height via out params.
+    bool decode_png(const std::vector<unsigned char> &png, UINT &w, UINT &h, std::vector<unsigned char> &bgra) {
+      Com<IWICImagingFactory> f;
+      if (FAILED(CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&f)))) {
+        return false;
+      }
+      Com<IWICStream> s;
+      if (FAILED(f->CreateStream(&s)) || FAILED(s->InitializeFromMemory(const_cast<BYTE *>(png.data()), static_cast<DWORD>(png.size())))) {
+        return false;
+      }
+      Com<IWICBitmapDecoder> dec;
+      Com<IWICBitmapFrameDecode> frame;
+      Com<IWICFormatConverter> conv;
+      if (FAILED(f->CreateDecoderFromStream(s.p, nullptr, WICDecodeMetadataCacheOnDemand, &dec)) || FAILED(dec->GetFrame(0, &frame)) ||
+          FAILED(f->CreateFormatConverter(&conv)) ||
+          FAILED(conv->Initialize(frame.p, GUID_WICPixelFormat32bppBGRA, WICBitmapDitherTypeNone, nullptr, 0.0, WICBitmapPaletteTypeCustom)) ||
+          FAILED(conv->GetSize(&w, &h)) || w == 0 || h == 0) {
+        return false;
+      }
+      bgra.resize(static_cast<size_t>(w) * h * 4);
+      return SUCCEEDED(conv->CopyPixels(nullptr, w * 4, static_cast<UINT>(bgra.size()), bgra.data()));
+    }
+
+    HGLOBAL global_copy(const void *data, size_t n) {
+      HGLOBAL g = GlobalAlloc(GMEM_MOVEABLE, n);
+      if (!g) {
+        return nullptr;
+      }
+      void *p = GlobalLock(g);
+      std::memcpy(p, data, n);
+      GlobalUnlock(g);
+      return g;
+    }
+
+    /// Run on a fresh STA thread: clipboard + WIC need an initialized COM apartment we own.
+    template<class F>
+    auto on_sta(F f) -> decltype(f()) {
+      decltype(f()) result {};
+      std::thread t([&] {
+        bool co = SUCCEEDED(CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED));
+        result = f();
+        if (co) {
+          CoUninitialize();
+        }
+      });
+      t.join();
+      return result;
+    }
+
+    class WinClipboardImage: public ClipboardImagePlatform {
+    public:
+      std::optional<std::vector<unsigned char>> get_png() override {
+        return on_sta([]() -> std::optional<std::vector<unsigned char>> {
+          Clip clip;
+          if (!clip.open) {
+            return std::nullopt;
+          }
+          UINT png_fmt = RegisterClipboardFormatW(L"PNG");
+          if (png_fmt && IsClipboardFormatAvailable(png_fmt)) {
+            if (HANDLE h = GetClipboardData(png_fmt)) {
+              auto *p = static_cast<unsigned char *>(GlobalLock(h));
+              if (p) {
+                std::vector<unsigned char> out(p, p + GlobalSize(h));
+                GlobalUnlock(h);
+                return out;
+              }
+            }
+          }
+          if (IsClipboardFormatAvailable(CF_BITMAP)) {
+            if (auto bmp = static_cast<HBITMAP>(GetClipboardData(CF_BITMAP))) {
+              return png_from_hbitmap(bmp);
+            }
+          }
+          return std::nullopt;
+        });
+      }
+
+      bool set_png(const std::vector<unsigned char> &png) override {
+        return on_sta([&png]() -> bool {
+          UINT w = 0, h = 0;
+          std::vector<unsigned char> bgra;
+          if (!decode_png(png, w, h, bgra)) {
+            return false;
+          }
+          // CF_DIB: BITMAPINFOHEADER + bottom-up 32bpp rows.
+          BITMAPINFOHEADER bih {};
+          bih.biSize = sizeof(bih);
+          bih.biWidth = static_cast<LONG>(w);
+          bih.biHeight = static_cast<LONG>(h);
+          bih.biPlanes = 1;
+          bih.biBitCount = 32;
+          bih.biCompression = BI_RGB;
+          size_t row = static_cast<size_t>(w) * 4;
+          std::vector<unsigned char> dib(sizeof(bih) + row * h);
+          std::memcpy(dib.data(), &bih, sizeof(bih));
+          for (UINT y = 0; y < h; ++y) {
+            std::memcpy(dib.data() + sizeof(bih) + (h - 1 - y) * row, bgra.data() + y * row, row);
+          }
+          Clip clip;
+          if (!clip.open || !EmptyClipboard()) {
+            return false;
+          }
+          bool ok = false;
+          if (HGLOBAL g = global_copy(dib.data(), dib.size())) {
+            if (SetClipboardData(CF_DIB, g)) {
+              ok = true;
+            } else {
+              GlobalFree(g);
+            }
+          }
+          UINT png_fmt = RegisterClipboardFormatW(L"PNG");
+          if (png_fmt) {
+            if (HGLOBAL g = global_copy(png.data(), png.size())) {
+              if (!SetClipboardData(png_fmt, g)) {
+                GlobalFree(g);
+              }
+            }
+          }
+          return ok;
+        });
+      }
+    };
+  }  // namespace
+
+  std::shared_ptr<ClipboardImagePlatform> make_platform_clipboard_image() {
+    return std::make_shared<WinClipboardImage>();
+  }
+}  // namespace orbit
