+/**
+ * @file src/orbit/api_routes.cpp
+ * @brief Orbit HTTPS API (/orbit/...) on the nvhttp mTLS server.
+ */
+#include "api_routes.h"
+
+#include "client_perm.h"
+
+#include <algorithm>
+#include <charconv>
+#include <cstdint>
+#include <nlohmann/json.hpp>
+
+namespace orbit {
+  namespace {
+    /// 0 = allowed, else the HTTP status to answer with.
+    int check_view(const crypto::named_cert_t *cert) {
+      if (cert == nullptr) {
+        return 401;
+      }
+      return has_perm(cert, crypto::PERM::view) ? 0 : 403;
+    }
+
+    bool parse_u64(const std::string &s, uint64_t &out) {
+      if (s.empty()) {
+        return false;
+      }
+      auto [p, ec] = std::from_chars(s.data(), s.data() + s.size(), out);
+      return ec == std::errc {} && p == s.data() + s.size();
+    }
+  }  // namespace
+
+  std::string status_json(const Status &s) {
+    nlohmann::json j;
+    j["seq"] = s.seq;
+    j["activeApp"] = s.active_app;
+    j["windowTitle"] = s.window_title;
+    j["media"] = {{"title", s.media_title}, {"artist", s.media_artist}, {"app", s.media_app}, {"playing", s.media_playing}};
+    nlohmann::json level = nullptr;
+    if (s.volume >= 0) {
+      level = s.volume;
+    }
+    j["volume"] = {{"level", level}, {"muted", s.muted}};
+    // Titles come from other programs and may hold invalid UTF-8: replace instead of throwing.
+    return j.dump(-1, ' ', false, nlohmann::json::error_handler_t::replace);
+  }
+
+  ApiReply status_reply(const crypto::named_cert_t *cert, StatusTracker &tracker) {
+    if (int err = check_view(cert)) {
+      return {err, {}};
+    }
+    tracker.note_activity();
+    tracker.refresh_if_stale(std::chrono::seconds {1});
+    return {200, status_json(tracker.current())};
+  }
+
+  EventsRequest parse_events_request(const crypto::named_cert_t *cert, const std::map<std::string, std::string> &query) {
+    EventsRequest r;
+    if (int err = check_view(cert)) {
+      r.error_status = err;
+      return r;
+    }
+
+    // No `since`: the client has nothing yet, answer at once with the current status.
+    auto since = query.find("since");
+    if (since == query.end()) {
+      r.since = UINT64_MAX;
+    } else if (!parse_u64(since->second, r.since)) {
+      r.error_status = 400;
+      return r;
+    }
+
+    auto timeout = query.find("timeout");
+    if (timeout != query.end()) {
+      uint64_t secs = 0;
+      if (!parse_u64(timeout->second, secs)) {
+        r.error_status = 400;
+        return r;
+      }
+      r.timeout = std::chrono::seconds {std::min<uint64_t>(secs, kMaxEventsTimeout.count())};
+    }
+    return r;
+  }
+}  // namespace orbit
