+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+/**
+ * @file src/orbit/status_tracker.h
+ * @brief PC status (active window, media, volume) with change sequence and long-poll waiters.
+ */
+#pragma once
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace orbit {
+  /// Snapshot of the PC state shown in the remote-control status bar.
+  struct Status {
+    uint64_t seq = 0;  ///< incremented on every change
+    std::string active_app;  ///< foreground process image name (e.g. "chrome.exe")
+    std::string window_title;
+    std::string media_title;
+    std::string media_artist;
+    std::string media_app;  ///< SMTC source app id
+    bool media_playing = false;
+    int volume = -1;  ///< master volume 0..100, -1 when unknown
+    bool muted = false;
+
+    /// Compare everything except seq.
+    bool same_content(const Status &o) const;
+  };
+
+  /// Reads the current status from the system. Must never throw; unknown fields stay empty.
+  class StatusSource {
+  public:
+    virtual ~StatusSource() = default;
+    virtual Status read() = 0;
+  };
+
+  /// Platform source (Windows: foreground window, Core Audio, SMTC). Never null.
+  std::unique_ptr<StatusSource> make_platform_status_source();
+
+  class StatusTracker {
+  public:
+    using clock_fn = std::function<std::chrono::steady_clock::time_point()>;
+    using callback = std::function<void(Status)>;
+
+    explicit StatusTracker(std::unique_ptr<StatusSource> source, clock_fn clock = &std::chrono::steady_clock::now);
+    ~StatusTracker();
+
+    StatusTracker(const StatusTracker &) = delete;
+    StatusTracker &operator=(const StatusTracker &) = delete;
+
+    Status current();
+
+    /// Read the source once; seq grows only if something changed. Answers changed/expired waiters.
+    void poll_once();
+
+    /**
+     * @brief Call `done` once seq != since or after `timeout` (with the current status).
+     * Answers right away when `since` is already stale. At most one waiter per non-empty `client_uuid`:
+     * a new one replaces the old, which is answered immediately with the current status.
+     */
+    void wait_change(uint64_t since, std::chrono::milliseconds timeout, callback done, const std::string &client_uuid = {});
+
+    /// Mark API activity; the poll thread only reads the source while clients are active.
+    void note_activity();
+
+    /// Poll synchronously if the last read is older than max_age (used when the poll thread is idle).
+    void refresh_if_stale(std::chrono::milliseconds max_age);
+
+    /// Start the background poll thread.
+    void start(std::chrono::milliseconds interval = std::chrono::milliseconds {500});
+
+    /// Stop the poll thread and answer all pending waiters; later waits are answered immediately.
+    void shutdown();
+
+  private:
+    struct Waiter {
+      uint64_t since;
+      std::chrono::steady_clock::time_point deadline;
+      callback done;
+      std::string client_uuid;
+    };
+
+    void run(std::chrono::milliseconds interval);
+
+    std::unique_ptr<StatusSource> source_;
+    clock_fn clock_;
+
+    std::mutex m_;
+    Status status_;
+    bool have_read_ = false;
+    std::chrono::steady_clock::time_point last_read_ {};
+    std::chrono::steady_clock::time_point last_activity_ {};
+    std::vector<Waiter> waiters_;
+    bool stopped_ = false;
+
+    std::mutex source_m_;  ///< serializes source reads (poll thread vs. refresh_if_stale)
+
+    std::condition_variable cv_;
+    std::thread thread_;
+  };
+}  // namespace orbit
