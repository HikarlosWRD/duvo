+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+/**
+ * @file src/orbit/status_tracker.cpp
+ * @brief PC status (active window, media, volume) with change sequence and long-poll waiters.
+ */
+#include "status_tracker.h"
+
+#include <utility>
+
+namespace orbit {
+  namespace {
+    /// The poll thread keeps reading the system only while a client used the API recently.
+    constexpr auto kActiveWindow = std::chrono::seconds {60};
+  }  // namespace
+
+  bool Status::same_content(const Status &o) const {
+    return active_app == o.active_app && window_title == o.window_title && media_title == o.media_title &&
+           media_artist == o.media_artist && media_app == o.media_app && media_playing == o.media_playing &&
+           volume == o.volume && muted == o.muted;
+  }
+
+  StatusTracker::StatusTracker(std::unique_ptr<StatusSource> source, clock_fn clock):
+      source_ {std::move(source)},
+      clock_ {std::move(clock)} {
+  }
+
+  StatusTracker::~StatusTracker() {
+    shutdown();
+  }
+
+  Status StatusTracker::current() {
+    std::lock_guard lk {m_};
+    return status_;
+  }
+
+  void StatusTracker::poll_once() {
+    Status fresh;
+    {
+      std::lock_guard src_lk {source_m_};
+      try {
+        fresh = source_->read();
+      } catch (...) {
+        fresh = Status {};
+      }
+    }
+
+    std::vector<std::pair<callback, Status>> ready;
+    {
+      std::lock_guard lk {m_};
+      auto now = clock_();
+      if (!fresh.same_content(status_)) {
+        fresh.seq = status_.seq + 1;
+        status_ = std::move(fresh);
+      }
+      have_read_ = true;
+      last_read_ = now;
+
+      for (auto it = waiters_.begin(); it != waiters_.end();) {
+        if (it->since != status_.seq || it->deadline <= now) {
+          ready.emplace_back(std::move(it->done), status_);
+          it = waiters_.erase(it);
+        } else {
+          ++it;
+        }
+      }
+    }
+    for (auto &[done, s] : ready) {
+      done(std::move(s));
+    }
+  }
+
+  void StatusTracker::wait_change(uint64_t since, std::chrono::milliseconds timeout, callback done, const std::string &client_uuid) {
+    std::vector<callback> answer_now;
+    Status snapshot;
+    {
+      std::lock_guard lk {m_};
+      auto now = clock_();
+      last_activity_ = now;
+      snapshot = status_;
+
+      if (stopped_ || since != status_.seq || timeout <= std::chrono::milliseconds::zero()) {
+        answer_now.emplace_back(std::move(done));
+      } else {
+        if (!client_uuid.empty()) {
+          for (auto it = waiters_.begin(); it != waiters_.end(); ++it) {
+            if (it->client_uuid == client_uuid) {
+              answer_now.emplace_back(std::move(it->done));
+              waiters_.erase(it);
+              break;
+            }
+          }
+        }
+        waiters_.push_back(Waiter {since, now + timeout, std::move(done), client_uuid});
+      }
+    }
+    for (auto &cb : answer_now) {
+      cb(snapshot);
+    }
+  }
+
+  void StatusTracker::note_activity() {
+    std::lock_guard lk {m_};
+    last_activity_ = clock_();
+  }
+
+  void StatusTracker::refresh_if_stale(std::chrono::milliseconds max_age) {
+    bool stale;
+    {
+      std::lock_guard lk {m_};
+      stale = !have_read_ || clock_() - last_read_ > max_age;
+    }
+    if (stale) {
+      poll_once();
+    }
+  }
+
+  void StatusTracker::start(std::chrono::milliseconds interval) {
+    std::lock_guard lk {m_};
+    if (thread_.joinable() || stopped_) {
+      return;
+    }
+    thread_ = std::thread {[this, interval]() {
+      run(interval);
+    }};
+  }
+
+  void StatusTracker::run(std::chrono::milliseconds interval) {
+    std::unique_lock lk {m_};
+    while (!stopped_) {
+      cv_.wait_for(lk, interval, [this]() {
+        return stopped_;
+      });
+      if (stopped_) {
+        break;
+      }
+      bool active = !waiters_.empty() || clock_() - last_activity_ < kActiveWindow;
+      if (!active) {
+        continue;
+      }
+      lk.unlock();
+      poll_once();
+      lk.lock();
+    }
+  }
+
+  void StatusTracker::shutdown() {
+    std::vector<Waiter> pending;
+    Status snapshot;
+    {
+      std::lock_guard lk {m_};
+      stopped_ = true;
+      pending.swap(waiters_);
+      snapshot = status_;
+    }
+    cv_.notify_all();
+    if (thread_.joinable() && thread_.get_id() != std::this_thread::get_id()) {
+      thread_.join();
+    }
+    for (auto &w : pending) {
+      w.done(snapshot);
+    }
+  }
+
+#ifndef _WIN32
+  namespace {
+    struct NullStatusSource: StatusSource {
+      Status read() override {
+        return {};
+      }
+    };
+  }  // namespace
+
+  std::unique_ptr<StatusSource> make_platform_status_source() {
+    return std::make_unique<NullStatusSource>();
+  }
+#endif
+}  // namespace orbit
