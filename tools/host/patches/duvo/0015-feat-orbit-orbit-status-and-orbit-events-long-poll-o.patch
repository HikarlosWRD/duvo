index 00000000..2cec7f70
--- /dev/null
+++ b/tests/unit/test_status_tracker.cpp
@@ -0,0 +1,223 @@
+/*
+ * Orbit - game streaming host (fork of Apollo/Sunshine).
+ * Copyright (C) 2026 Orbit contributors.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+/**
+ * @file tests/unit/test_status_tracker.cpp
+ * @brief Test src/orbit/status_tracker.* and src/orbit/api_routes.*
+ */
+#include "../tests_common.h"
+
+#include <nlohmann/json.hpp>
+#include <optional>
+#include <src/orbit/api_routes.h>
+#include <src/orbit/status_tracker.h>
+
+using namespace std::chrono_literals;
+
+namespace {
+  struct FakeSource: orbit::StatusSource {
+    orbit::Status *value;
+
+    explicit FakeSource(orbit::Status *v):
+        value {v} {}
+
+    orbit::Status read() override {
+      return *value;
+    }
+  };
+
+  struct FakeClock {
+    std::chrono::steady_clock::time_point now {std::chrono::steady_clock::time_point {} + 1000s};
+  };
+
+  struct Fixture {
+    orbit::Status src {};
+    FakeClock clk;
+    orbit::StatusTracker tracker {std::make_unique<FakeSource>(&src), [this]() {
+                                    return clk.now;
+                                  }};
+
+    Fixture() {
+      src.window_title = "A";
+      src.active_app = "a.exe";
+      src.volume = 50;
+      tracker.poll_once();
+    }
+  };
+}  // namespace
+
+TEST(StatusTracker, SeqOnlyIncrementsOnChange) {
+  Fixture f;
+  auto s0 = f.tracker.current().seq;
+  f.tracker.poll_once();
+  f.tracker.poll_once();
+  EXPECT_EQ(f.tracker.current().seq, s0);
+
+  f.src.window_title = "B";
+  f.tracker.poll_once();
+  EXPECT_EQ(f.tracker.current().seq, s0 + 1);
+  EXPECT_EQ(f.tracker.current().window_title, "B");
+
+  f.tracker.poll_once();
+  EXPECT_EQ(f.tracker.current().seq, s0 + 1);
+
+  f.src.muted = true;
+  f.tracker.poll_once();
+  EXPECT_EQ(f.tracker.current().seq, s0 + 2);
+}
+
+TEST(StatusTracker, WaitAnswersOnChange) {
+  Fixture f;
+  auto s0 = f.tracker.current().seq;
+  std::optional<orbit::Status> got;
+  f.tracker.wait_change(s0, 25s, [&](orbit::Status s) {
+    got = s;
+  });
+  EXPECT_FALSE(got);
+
+  f.tracker.poll_once();  // nothing changed
+  EXPECT_FALSE(got);
+
+  f.src.window_title = "B";
+  f.tracker.poll_once();
+  ASSERT_TRUE(got);
+  EXPECT_EQ(got->seq, s0 + 1);
+  EXPECT_EQ(got->window_title, "B");
+}
+
+TEST(StatusTracker, WaitAnswersImmediatelyWhenSinceIsStale) {
+  Fixture f;
+  auto s0 = f.tracker.current().seq;
+  std::optional<orbit::Status> got;
+  f.tracker.wait_change(s0 + 7, 25s, [&](orbit::Status s) {
+    got = s;
+  });
+  ASSERT_TRUE(got);
+  EXPECT_EQ(got->seq, s0);
+}
+
+TEST(StatusTracker, WaitTimesOutWithCurrent) {
+  Fixture f;
+  auto s0 = f.tracker.current().seq;
+  std::optional<orbit::Status> got;
+  f.tracker.wait_change(s0, 25s, [&](orbit::Status s) {
+    got = s;
+  });
+
+  f.clk.now += 24s;
+  f.tracker.poll_once();
+  EXPECT_FALSE(got);
+
+  f.clk.now += 1s;
+  f.tracker.poll_once();
+  ASSERT_TRUE(got);
+  EXPECT_EQ(got->seq, s0);
+  EXPECT_EQ(got->window_title, "A");
+}
+
+TEST(StatusTracker, NewWaitReplacesOldForSameClient) {
+  Fixture f;
+  auto s0 = f.tracker.current().seq;
+  int first = 0, second = 0, other = 0;
+  f.tracker.wait_change(s0, 25s, [&](orbit::Status s) {
+    ++first;
+    EXPECT_EQ(s.seq, s0);
+  }, "uuid-1");
+  f.tracker.wait_change(s0, 25s, [&](orbit::Status) {
+    ++other;
+  }, "uuid-2");
+  EXPECT_EQ(first, 0);
+
+  f.tracker.wait_change(s0, 25s, [&](orbit::Status) {
+    ++second;
+  }, "uuid-1");
+  EXPECT_EQ(first, 1);  // old one answered right away with the current status
+  EXPECT_EQ(second, 0);
+  EXPECT_EQ(other, 0);  // other clients are untouched
+
+  f.src.window_title = "B";
+  f.tracker.poll_once();
+  EXPECT_EQ(first, 1);
+  EXPECT_EQ(second, 1);
+  EXPECT_EQ(other, 1);
+}
+
+TEST(StatusTracker, ShutdownAnswersPendingAndLaterWaits) {
+  Fixture f;
+  auto s0 = f.tracker.current().seq;
+  int n = 0;
+  f.tracker.wait_change(s0, 25s, [&](orbit::Status) {
+    ++n;
+  }, "u");
+  f.tracker.shutdown();
+  EXPECT_EQ(n, 1);
+  f.tracker.wait_change(s0, 25s, [&](orbit::Status) {
+    ++n;
+  }, "u");
+  EXPECT_EQ(n, 2);
+}
+
+TEST(OrbitApi, StatusRequiresView) {
+  orbit::Status src {};
+  src.window_title = "Doc - Editor";
+  src.active_app = "editor.exe";
+  src.volume = 30;
+  orbit::StatusTracker tracker {std::make_unique<FakeSource>(&src)};
+  tracker.poll_once();
+
+  crypto::named_cert_t no_view {};
+  no_view.perm = crypto::PERM::input_kbd;
+  EXPECT_EQ(orbit::status_reply(&no_view, tracker).status, 403);
+
+  EXPECT_EQ(orbit::status_reply(nullptr, tracker).status, 401);
+
+  crypto::named_cert_t viewer {};
+  viewer.perm = crypto::PERM::view;
+  auto r = orbit::status_reply(&viewer, tracker);
+  EXPECT_EQ(r.status, 200);
+  auto j = nlohmann::json::parse(r.body);
+  EXPECT_EQ(j["seq"].get<uint64_t>(), tracker.current().seq);
+  EXPECT_EQ(j["windowTitle"], "Doc - Editor");
+  EXPECT_EQ(j["activeApp"], "editor.exe");
+  EXPECT_EQ(j["volume"]["level"], 30);
+  EXPECT_EQ(j["volume"]["muted"], false);
+  EXPECT_EQ(j["media"]["playing"], false);
+  EXPECT_EQ(j["media"]["title"], "");
+}
+
+TEST(OrbitApi, EventsParamsRequireViewAndClampTimeout) {
+  crypto::named_cert_t no_view {};
+  no_view.perm = crypto::PERM::input_kbd;
+  EXPECT_EQ(orbit::parse_events_request(&no_view, {}).error_status, 403);
+  EXPECT_EQ(orbit::parse_events_request(nullptr, {}).error_status, 401);
+
+  crypto::named_cert_t viewer {};
+  viewer.perm = crypto::PERM::view;
+  auto r = orbit::parse_events_request(&viewer, {{"since", "5"}, {"timeout", "100"}});
+  EXPECT_EQ(r.error_status, 0);
+  EXPECT_EQ(r.since, 5u);
+  EXPECT_EQ(r.timeout, 25s);
+
+  r = orbit::parse_events_request(&viewer, {{"since", "5"}, {"timeout", "3"}});
+  EXPECT_EQ(r.timeout, 3s);
+
+  r = orbit::parse_events_request(&viewer, {{"since", "5"}});
+  EXPECT_EQ(r.timeout, 25s);
+
+  EXPECT_EQ(orbit::parse_events_request(&viewer, {{"since", "abc"}}).error_status, 400);
+  EXPECT_EQ(orbit::parse_events_request(&viewer, {{"since", "1"}, {"timeout", "-4"}}).error_status, 400);
+}
