+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+/**
+ * @file src/orbit/api_routes.h
+ * @brief Orbit HTTPS API (/orbit/...) on the nvhttp mTLS server.
+ */
+#pragma once
+
+#include "src/crypto.h"
+#include "status_tracker.h"
+
+#include <chrono>
+#include <map>
+#include <Simple-Web-Server/status_code.hpp>
+#include <memory>
+#include <string>
+
+namespace orbit {
+  /// Long-poll timeout cap (spec §10.6).
+  inline constexpr std::chrono::seconds kMaxEventsTimeout {25};
+
+  struct ApiReply {
+    int status;  ///< HTTP status code
+    std::string body;  ///< JSON (empty for errors)
+  };
+
+  /// JSON for a status: {seq, activeApp, windowTitle, media:{title,artist,app,playing}, volume:{level,muted}}.
+  std::string status_json(const Status &s);
+
+  /// GET /orbit/status: 401 unknown client, 403 without `view`, 200 + JSON otherwise.
+  ApiReply status_reply(const crypto::named_cert_t *cert, StatusTracker &tracker);
+
+  struct EventsRequest {
+    int error_status = 0;  ///< 0 = ok, else HTTP status to answer with
+    uint64_t since = 0;
+    std::chrono::milliseconds timeout {kMaxEventsTimeout};
+  };
+
+  /// GET /orbit/events?since=&timeout=: validate permission and parameters (timeout clamped to 25 s).
+  EventsRequest parse_events_request(const crypto::named_cert_t *cert, const std::map<std::string, std::string> &query);
+
+  /// Keeps the tracker alive for the server's lifetime; destroying it stops polling and answers pending waits.
+  struct ApiHandle {
+    std::shared_ptr<StatusTracker> tracker;
+
+    ~ApiHandle() {
+      if (tracker) {
+        tracker->shutdown();
+      }
+    }
+  };
+
+  /**
+   * @brief Register the /orbit/ routes on the nvhttp HTTPS (mTLS) server. Never call this for the plain HTTP server.
+   * The verified client is in request->userp (set by the server's certificate check).
+   */
+  template<class Server>
+  std::unique_ptr<ApiHandle> register_api(Server &server) {
+    auto handle = std::make_unique<ApiHandle>();
+    handle->tracker = std::make_shared<StatusTracker>(make_platform_status_source());
+    handle->tracker->start();
+    auto tracker = handle->tracker;
+
+    server.resource["^/orbit/status$"]["GET"] = [tracker](auto response, auto request) {
+      auto cert = static_cast<const crypto::named_cert_t *>(request->userp.get());
+      auto reply = status_reply(cert, *tracker);
+      if (reply.status != 200) {
+        response->write(static_cast<SimpleWeb::StatusCode>(reply.status));
+        response->close_connection_after_response = true;
+        return;
+      }
+      response->write(SimpleWeb::StatusCode::success_ok, reply.body, {{"Content-Type", "application/json"}});
+    };
+
+    server.resource["^/orbit/events$"]["GET"] = [tracker](auto response, auto request) {
+      auto cert = static_cast<const crypto::named_cert_t *>(request->userp.get());
+      std::map<std::string, std::string> query;
+      for (auto &[k, v] : request->parse_query_string()) {
+        query[k] = v;
+      }
+      auto ev = parse_events_request(cert, query);
+      if (ev.error_status != 0) {
+        response->write(static_cast<SimpleWeb::StatusCode>(ev.error_status));
+        response->close_connection_after_response = true;
+        return;
+      }
+      tracker->refresh_if_stale(std::chrono::seconds {1});
+      // Async: keep `response` in the callback; it is sent when the callback is answered and released.
+      tracker->wait_change(ev.since, ev.timeout, [response](Status s) {
+        response->write(SimpleWeb::StatusCode::success_ok, status_json(s), {{"Content-Type", "application/json"}});
+      }, cert->uuid);
+    };
+
+    return handle;
+  }
+}  // namespace orbit
