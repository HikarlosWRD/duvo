+/**
+ * @file src/orbit/platform_status_win.cpp
+ * @brief Windows StatusSource: foreground window + process, Core Audio master volume, SMTC media.
+ *
+ * Every call is best effort: the host may run as SYSTEM in the user session, where some sources fail.
+ * A failing source leaves its fields empty; nothing here throws.
+ */
+#include "status_tracker.h"
+
+// clang-format off
+#include <windows.h>
+#include <endpointvolume.h>
+#include <mmdeviceapi.h>
+// clang-format on
+
+#include <winrt/windows.foundation.h>
+#include <winrt/windows.media.control.h>
+
+#include <chrono>
+#include <cmath>
+#include <stdexcept>
+#include <string>
+
+namespace orbit {
+  namespace {
+    namespace smtc = winrt::Windows::Media::Control;
+
+    std::string to_utf8(const wchar_t *w, int len) {
+      if (len <= 0) {
+        return {};
+      }
+      int n = WideCharToMultiByte(CP_UTF8, 0, w, len, nullptr, 0, nullptr, nullptr);
+      if (n <= 0) {
+        return {};
+      }
+      std::string out(n, '\0');
+      WideCharToMultiByte(CP_UTF8, 0, w, len, out.data(), n, nullptr, nullptr);
+      return out;
+    }
+
+    std::string to_utf8(const winrt::hstring &h) {
+      return to_utf8(h.c_str(), static_cast<int>(h.size()));
+    }
+
+    /// Keep this thread in the MTA for its whole life (cached WinRT/COM objects stay valid between polls).
+    struct ComThread {
+      bool ok;
+
+      ComThread():
+          ok {SUCCEEDED(CoInitializeEx(nullptr, COINIT_MULTITHREADED))} {}
+
+      ~ComThread() {
+        if (ok) {
+          CoUninitialize();
+        }
+      }
+    };
+
+    void read_foreground(Status &s) {
+      HWND hwnd = GetForegroundWindow();
+      if (hwnd == nullptr) {
+        return;
+      }
+      wchar_t title[512];
+      int len = GetWindowTextW(hwnd, title, static_cast<int>(std::size(title)));
+      s.window_title = to_utf8(title, len);
+
+      DWORD pid = 0;
+      GetWindowThreadProcessId(hwnd, &pid);
+      if (pid == 0) {
+        return;
+      }
+      HANDLE proc = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+      if (proc == nullptr) {
+        return;
+      }
+      wchar_t path[MAX_PATH * 2];
+      DWORD size = static_cast<DWORD>(std::size(path));
+      if (QueryFullProcessImageNameW(proc, 0, path, &size) && size > 0) {
+        std::wstring_view full {path, size};
+        auto slash = full.find_last_of(L"\\/");
+        auto base = slash == std::wstring_view::npos ? full : full.substr(slash + 1);
+        s.active_app = to_utf8(base.data(), static_cast<int>(base.size()));
+      }
+      CloseHandle(proc);
+    }
+
+    void read_volume(Status &s) {
+      IMMDeviceEnumerator *enumerator = nullptr;
+      IMMDevice *device = nullptr;
+      IAudioEndpointVolume *endpoint = nullptr;
+      if (SUCCEEDED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, __uuidof(IMMDeviceEnumerator), reinterpret_cast<void **>(&enumerator))) &&
+          SUCCEEDED(enumerator->GetDefaultAudioEndpoint(eRender, eConsole, &device)) &&
+          SUCCEEDED(device->Activate(__uuidof(IAudioEndpointVolume), CLSCTX_ALL, nullptr, reinterpret_cast<void **>(&endpoint)))) {
+        float level = 0.0f;
+        BOOL mute = FALSE;
+        if (SUCCEEDED(endpoint->GetMasterVolumeLevelScalar(&level))) {
+          s.volume = static_cast<int>(std::lround(level * 100.0f));
+        }
+        if (SUCCEEDED(endpoint->GetMute(&mute))) {
+          s.muted = mute != FALSE;
+        }
+      }
+      if (endpoint) {
+        endpoint->Release();
+      }
+      if (device) {
+        device->Release();
+      }
+      if (enumerator) {
+        enumerator->Release();
+      }
+    }
+
+    class WinStatusSource: public StatusSource {
+    public:
+      Status read() override {
+        thread_local ComThread com;
+        Status s;
+        try {
+          read_foreground(s);
+        } catch (...) {
+        }
+        try {
+          read_volume(s);
+        } catch (...) {
+        }
+        read_media(s);
+        return s;
+      }
+
+    private:
+      static constexpr auto kAsyncWait = std::chrono::milliseconds {400};
+      static constexpr auto kRetryAfterFailure = std::chrono::seconds {10};
+
+      template<class Op>
+      static bool finished(const Op &op) {
+        return op.wait_for(kAsyncWait) == winrt::Windows::Foundation::AsyncStatus::Completed;
+      }
+
+      void read_media(Status &s) {
+        auto now = std::chrono::steady_clock::now();
+        if (!manager_ && now < retry_at_) {
+          return;
+        }
+        try {
+          if (!manager_) {
+            auto op = smtc::GlobalSystemMediaTransportControlsSessionManager::RequestAsync();
+            if (!finished(op)) {
+              op.Cancel();
+              throw std::runtime_error("SMTC manager request timed out");
+            }
+            manager_ = op.GetResults();
+          }
+          auto session = manager_.GetCurrentSession();
+          if (!session) {
+            return;
+          }
+          s.media_app = to_utf8(session.SourceAppUserModelId());
+          auto info = session.GetPlaybackInfo();
+          if (info) {
+            s.media_playing = info.PlaybackStatus() == smtc::GlobalSystemMediaTransportControlsSessionPlaybackStatus::Playing;
+          }
+          auto props_op = session.TryGetMediaPropertiesAsync();
+          if (finished(props_op)) {
+            auto props = props_op.GetResults();
+            if (props) {
+              s.media_title = to_utf8(props.Title());
+              s.media_artist = to_utf8(props.Artist());
+            }
+          } else {
+            props_op.Cancel();
+          }
+        } catch (...) {
+          // e.g. SMTC unavailable for this process (SYSTEM context): no media, retry later
+          manager_ = nullptr;
+          retry_at_ = now + kRetryAfterFailure;
+          s.media_title.clear();
+          s.media_artist.clear();
+          s.media_app.clear();
+          s.media_playing = false;
+        }
+      }
+
+      smtc::GlobalSystemMediaTransportControlsSessionManager manager_ {nullptr};
+      std::chrono::steady_clock::time_point retry_at_ {};
+    };
+  }  // namespace
+
+  std::unique_ptr<StatusSource> make_platform_status_source() {
+    return std::make_unique<WinStatusSource>();
+  }
+}  // namespace orbit
