+/**
+ * @file src/orbit/client_perm.cpp
+ * @brief Permissions assigned to newly paired clients.
+ */
+#include "client_perm.h"
+
+namespace orbit {
+  crypto::PERM perm_for_new_client(bool paired_via_otp, bool is_first_client) {
+    if (paired_via_otp) {
+      return kQrPairedPerm;
+    }
+    return is_first_client ? crypto::PERM::_all : crypto::PERM::_default;
+  }
+}  // namespace orbit
