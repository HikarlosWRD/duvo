+/**
+ * @file tests/unit/test_client_perm.cpp
+ * @brief Test src/orbit/client_perm.*
+ */
+#include "../tests_common.h"
+
+#include <src/orbit/client_perm.h>
+
+using crypto::PERM;
+
+static bool has(PERM p, PERM bit) {
+  return !!(p & bit);
+}
+
+TEST(ClientPerm, OtpGetsQrPermsEvenIfFirst) {
+  EXPECT_EQ(orbit::perm_for_new_client(true, true), orbit::kQrPairedPerm);
+  EXPECT_EQ(orbit::perm_for_new_client(true, false), orbit::kQrPairedPerm);
+  for (auto p : {PERM::list, PERM::view, PERM::launch, PERM::input_controller, PERM::input_touch, PERM::input_pen, PERM::input_mouse, PERM::input_kbd}) {
+    EXPECT_TRUE(has(orbit::kQrPairedPerm, p));
+  }
+}
+
+TEST(ClientPerm, OtpPermsExcludeServerCmdFilesClipboard) {
+  for (auto p : {PERM::server_cmd, PERM::file_upload, PERM::file_dwnload, PERM::clipboard_read, PERM::clipboard_set}) {
+    EXPECT_FALSE(has(orbit::kQrPairedPerm, p));
+  }
+}
+
+TEST(ClientPerm, PinPairingFirstGetsAll) {
+  EXPECT_EQ(orbit::perm_for_new_client(false, true), PERM::_all);
+}
+
+TEST(ClientPerm, PinPairingLaterGetsDefault) {
+  EXPECT_EQ(orbit::perm_for_new_client(false, false), PERM::_default);
+}
