+++ b/src/nvhttp.cpp
@@ -30,6 +30,7 @@
 #include "network.h"
 #include "nvhttp.h"
 #include "orbit/otp_slot.h"  // ORBIT:
+#include "orbit/client_perm.h"  // ORBIT:
 #include "platform/common.h"
 #include "process.h"
 #include "rtsp.h"
@@ -625,11 +626,8 @@ namespace nvhttp {
       named_cert_p->cert = std::move(client.cert);
       named_cert_p->uuid = uuid_util::uuid_t::generate().string();
       // If the device is the first one paired with the server, assign full permission.
-      if (client_root.named_devices.empty()) {
-        named_cert_p->perm = PERM::_all;
-      } else {
-        named_cert_p->perm = PERM::_default;
-      }
+      // ORBIT: QR/OTP-paired clients get kQrPairedPerm regardless of order; PIN pairing keeps Apollo behaviour
+      named_cert_p->perm = orbit::perm_for_new_client(sess.paired_via_otp, client_root.named_devices.empty());
 
       named_cert_p->enable_legacy_ordering = true;
       named_cert_p->allow_client_commands = true;
@@ -766,6 +764,7 @@ namespace nvhttp {
               ptr->second.client.name = std::move(taken.device_name);
             }
 
+            ptr->second.paired_via_otp = true;  // ORBIT: QR/OTP-paired clients get orbit::kQrPairedPerm
             getservercert(ptr->second, tree, taken.pin);
             return;
           }
