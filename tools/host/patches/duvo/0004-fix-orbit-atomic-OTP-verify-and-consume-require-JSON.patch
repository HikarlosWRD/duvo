 }
 
+namespace {
+  const auto always = [](const orbit::OtpSlot::Otp &) {
+    return true;
+  };
+}
+
 TEST(PairQr, OtpSingleUse) {
   using namespace std::chrono_literals;
+  using S = orbit::OtpSlot::Status;
   orbit::OtpSlot slot;
   const auto t0 = orbit::OtpSlot::clock::time_point {} + 1000s;
 
-  EXPECT_EQ(slot.peek(t0), nullptr);  // nothing issued yet
+  EXPECT_EQ(slot.verify_and_take(t0, always).status, S::unavailable);  // nothing issued
   slot.issue("1234", "passphrase-abc", "", t0);
-  ASSERT_NE(slot.peek(t0 + 10s), nullptr);
-  EXPECT_EQ(slot.peek(t0 + 10s)->pin, "1234");
 
   // consume once -> ok, again -> rejected
-  auto first = slot.take(t0 + 10s);
-  ASSERT_TRUE(first.has_value());
-  EXPECT_EQ(first->passphrase, "passphrase-abc");
-  EXPECT_FALSE(slot.take(t0 + 11s).has_value());
+  auto first = slot.verify_and_take(t0 + 10s, always);
+  ASSERT_EQ(first.status, S::ok);
+  ASSERT_TRUE(first.otp.has_value());
+  EXPECT_EQ(first.otp->passphrase, "passphrase-abc");
+  EXPECT_EQ(slot.verify_and_take(t0 + 11s, always).status, S::unavailable);
 
-  // exactly at 180 s still valid, after 180 s rejected (and the slot is wiped)
+  // exactly 180 s still valid; just after, rejected without touching an empty optional
   slot.issue("5678", "other-passphrase", "", t0);
-  EXPECT_NE(slot.peek(t0 + 180s), nullptr);
-  EXPECT_EQ(slot.peek(t0 + 180s + 1ms), nullptr);
-  EXPECT_FALSE(slot.take(t0 + 180s + 1ms).has_value());
-  EXPECT_FALSE(slot.take(t0 + 1s).has_value());
+  EXPECT_EQ(slot.verify_and_take(t0 + 180s, [](const orbit::OtpSlot::Otp &) { return false; }).status, S::mismatch);
+  auto late = slot.verify_and_take(t0 + 180s + 1ms, always);
+  EXPECT_EQ(late.status, S::unavailable);
+  EXPECT_FALSE(late.otp.has_value());
+  EXPECT_FALSE(slot.take(t0 + 1s).has_value());  // wiped
 
   // re-issuing replaces the previous OTP
   slot.issue("1111", "aaaaaaaaaaaaaaaa", "", t0);
   slot.issue("2222", "bbbbbbbbbbbbbbbb", "", t0);
   EXPECT_EQ(slot.take(t0)->pin, "2222");
 }
+
+TEST(PairQr, OtpMismatchKeepsOtpMatchConsumes) {
+  using S = orbit::OtpSlot::Status;
+  orbit::OtpSlot slot;
+  const auto t0 = orbit::OtpSlot::clock::time_point {} + std::chrono::seconds {5};
+  slot.issue("4321", "pp-pp-pp-pp-pp-pp", "dev", t0);
+  auto is = [](const char *pin) {
+    return [pin](const orbit::OtpSlot::Otp &o) {
+      return o.pin == pin;
+    };
+  };
+  EXPECT_EQ(slot.verify_and_take(t0, is("0000")).status, S::mismatch);
+  EXPECT_EQ(slot.verify_and_take(t0, is("0000")).status, S::mismatch);  // still pending
+  auto ok = slot.verify_and_take(t0, is("4321"));
+  ASSERT_EQ(ok.status, S::ok);
+  EXPECT_EQ(ok.otp->device_name, "dev");
+  EXPECT_EQ(slot.verify_and_take(t0, is("4321")).status, S::unavailable);
+}
+
+TEST(PairQr, OtpConcurrentIssueAndVerify) {
+  orbit::OtpSlot slot;
+  std::atomic<bool> stop {false};
+  std::atomic<int> consumed {0};
+  std::thread issuer([&] {
+    while (!stop) {
+      slot.issue("1234", std::string(24, 'x'), "dev", orbit::OtpSlot::clock::now());
+    }
+  });
+  std::thread verifier([&] {
+    for (int i = 0; i < 200000; ++i) {
+      auto r = slot.verify_and_take(orbit::OtpSlot::clock::now(), [](const orbit::OtpSlot::Otp &o) {
+        return o.pin == "1234" && o.passphrase.size() == 24;
+      });
+      if (r.status == orbit::OtpSlot::Status::ok) {
+        EXPECT_TRUE(r.otp.has_value());
+        if (r.otp) {
+          EXPECT_EQ(r.otp->passphrase.size(), 24u);
+        }
+        ++consumed;
+      }
+    }
+    stop = true;
+  });
+  verifier.join();
+  issuer.join();
+  EXPECT_GT(consumed.load(), 0);
+}
