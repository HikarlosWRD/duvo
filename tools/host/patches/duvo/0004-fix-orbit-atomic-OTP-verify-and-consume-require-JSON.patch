From d90ef73eb88190d87eba6ce1389385419de41495 Mon Sep 17 00:00:00 2001
From: Orbit Dev <dev@orbit.invalid>
Date: Tue, 17 Nov 2026 21:41:22 -0300
Subject: [PATCH 04/31] fix(orbit): atomic OTP verify-and-consume, require JSON
 content type on pair-qr

OtpSlot gets a mutex and verify_and_take(now, predicate): one locked
expiry check + hash compare + consume with a single clock read (no
empty-optional deref, no dangling pointer, no consuming a newer OTP).
POST /api/orbit/pair-qr now calls validateContentType like getOTP.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/confighttp.cpp          |  2 +-
 src/nvhttp.cpp              | 28 ++++++-------
 src/orbit/otp_slot.cpp      | 27 +++++++------
 src/orbit/otp_slot.h        | 18 ++++++++-
 tests/unit/test_pair_qr.cpp | 80 +++++++++++++++++++++++++++++++------
 5 files changed, 112 insertions(+), 43 deletions(-)

diff --git a/src/confighttp.cpp b/src/confighttp.cpp
index 429bf035..1aca2627 100644
--- a/src/confighttp.cpp
+++ b/src/confighttp.cpp
@@ -1267,7 +1267,7 @@ namespace confighttp {
    * @api_examples{/api/orbit/pair-qr| POST| null}
    */
   void getOrbitPairQr(resp_https_t response, req_https_t request) {
-    if (!authenticate(response, request)) {
+    if (!validateContentType(response, request, "application/json") || !authenticate(response, request)) {
       return;
     }
 
diff --git a/src/nvhttp.cpp b/src/nvhttp.cpp
index ac88c7a2..714da9f3 100644
--- a/src/nvhttp.cpp
+++ b/src/nvhttp.cpp
@@ -752,24 +752,22 @@ namespace nvhttp {
 
         auto it = args.find("otpauth");
         if (it != std::end(args)) {
-          // ORBIT: expiry/single-use delegated to orbit::OtpSlot
-          const auto *otp = otp_slot.peek(std::chrono::steady_clock::now());
-          if (!otp) {
+          // ORBIT: expiry/single-use delegated to orbit::OtpSlot (one locked check-and-consume, single clock read)
+          auto otp_res = otp_slot.verify_and_take(std::chrono::steady_clock::now(), [&](const orbit::OtpSlot::Otp &o) {
+            auto hash = util::hex(crypto::hash(o.pin + ptr->second.async_insert_pin.salt + o.passphrase), true);
+            return hash.to_string_view() == it->second;
+          });
+          if (otp_res.status == orbit::OtpSlot::Status::unavailable) {
             tree.put("root.<xmlattr>.status_code", 503);
             tree.put("root.<xmlattr>.status_message", "OTP auth not available.");
-          } else {
-            auto hash = util::hex(crypto::hash(otp->pin + ptr->second.async_insert_pin.salt + otp->passphrase), true);
-
-            if (hash.to_string_view() == it->second) {
-              auto taken = otp_slot.take(std::chrono::steady_clock::now());
-
-              if (!taken->device_name.empty()) {
-                ptr->second.client.name = std::move(taken->device_name);
-              }
-
-              getservercert(ptr->second, tree, taken->pin);
-              return;
+          } else if (otp_res.status == orbit::OtpSlot::Status::ok) {
+            auto &taken = *otp_res.otp;
+            if (!taken.device_name.empty()) {
+              ptr->second.client.name = std::move(taken.device_name);
             }
+
+            getservercert(ptr->second, tree, taken.pin);
+            return;
           }
 
           // Always return positive, attackers will fail in the next steps.
diff --git a/src/orbit/otp_slot.cpp b/src/orbit/otp_slot.cpp
index 4822037c..eb07aeaa 100644
--- a/src/orbit/otp_slot.cpp
+++ b/src/orbit/otp_slot.cpp
@@ -23,27 +23,28 @@
 
 namespace orbit {
   void OtpSlot::issue(std::string pin, std::string passphrase, std::string device_name, clock::time_point now) {
+    std::lock_guard lock {m_};
     otp_ = Otp {std::move(pin), std::move(passphrase), std::move(device_name), now};
   }
 
-  const OtpSlot::Otp *OtpSlot::peek(clock::time_point now) {
-    if (!otp_) {
-      return nullptr;
-    }
-    if (otp_->pin.empty() || now - otp_->created > ttl_) {
+  OtpSlot::Result OtpSlot::verify_and_take(clock::time_point now, const std::function<bool(const Otp &)> &matches) {
+    std::lock_guard lock {m_};
+    if (!otp_ || otp_->pin.empty() || now - otp_->created > ttl_) {
       otp_.reset();
-      return nullptr;
+      return {Status::unavailable, std::nullopt};
+    }
+    if (!matches(*otp_)) {
+      return {Status::mismatch, std::nullopt};
     }
-    return &*otp_;
+    Result r {Status::ok, std::move(otp_)};
+    otp_.reset();
+    return r;
   }
 
   std::optional<OtpSlot::Otp> OtpSlot::take(clock::time_point now) {
-    if (!peek(now)) {
-      return std::nullopt;
-    }
-    auto out = std::move(otp_);
-    otp_.reset();
-    return out;
+    return verify_and_take(now, [](const Otp &) {
+      return true;
+    }).otp;
   }
 
   void OtpSlot::clear() {
diff --git a/src/orbit/otp_slot.h b/src/orbit/otp_slot.h
index e859139a..6c47f4b2 100644
--- a/src/orbit/otp_slot.h
+++ b/src/orbit/otp_slot.h
@@ -22,6 +22,8 @@
 #pragma once
 
 #include <chrono>
+#include <functional>
+#include <mutex>
 #include <optional>
 #include <string>
 
@@ -46,8 +48,19 @@ namespace orbit {
     /// Replace any pending OTP.
     void issue(std::string pin, std::string passphrase, std::string device_name, clock::time_point now);
 
-    /// The pending OTP if still valid at `now`; an expired one is wiped and nullptr returned.
-    const Otp *peek(clock::time_point now);
+    enum class Status {
+      unavailable,  ///< nothing pending or expired (slot wiped)
+      mismatch,  ///< predicate rejected; OTP stays pending
+      ok  ///< predicate accepted; OTP consumed
+    };
+
+    struct Result {
+      Status status;
+      std::optional<Otp> otp;  ///< set only when status == ok
+    };
+
+    /// Atomically: check expiry at `now`, evaluate `matches` on the pending OTP, consume on match.
+    Result verify_and_take(clock::time_point now, const std::function<bool(const Otp &)> &matches);
 
     /// Return the pending OTP if valid and clear it (single use).
     std::optional<Otp> take(clock::time_point now);
@@ -55,6 +68,7 @@ namespace orbit {
     void clear();
 
   private:
+    std::mutex m_;
     std::chrono::seconds ttl_;
     std::optional<Otp> otp_;
   };
