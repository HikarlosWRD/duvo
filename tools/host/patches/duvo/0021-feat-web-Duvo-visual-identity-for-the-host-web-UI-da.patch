diff --git a/src_assets/common/assets/web/public/assets/css/duvo.css b/src_assets/common/assets/web/public/assets/css/duvo.css
new file mode 100644
index 00000000..66bbe871
--- /dev/null
+++ b/src_assets/common/assets/web/public/assets/css/duvo.css
@@ -0,0 +1,119 @@
+/* Duvo visual identity for the host web UI: warm graphite ground, one amber accent, IBM Plex. */
+@font-face { font-family: "IBM Plex Sans"; font-weight: 400; font-style: normal; src: url("../fonts/ibmplexsans_regular.ttf") format("truetype"); font-display: swap; }
+@font-face { font-family: "IBM Plex Sans"; font-weight: 500; font-style: normal; src: url("../fonts/ibmplexsans_medium.ttf") format("truetype"); font-display: swap; }
+@font-face { font-family: "IBM Plex Sans"; font-weight: 600; font-style: normal; src: url("../fonts/ibmplexsans_semibold.ttf") format("truetype"); font-display: swap; }
+@font-face { font-family: "IBM Plex Mono"; font-weight: 400; font-style: normal; src: url("../fonts/ibmplexmono_regular.ttf") format("truetype"); font-display: swap; }
+@font-face { font-family: "IBM Plex Mono"; font-weight: 500; font-style: normal; src: url("../fonts/ibmplexmono_medium.ttf") format("truetype"); font-display: swap; }
+
+html:root {
+  --bs-font-sans-serif: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
+  --bs-font-monospace: "IBM Plex Mono", ui-monospace, Consolas, monospace;
+  --bs-border-radius: 0.75rem;
+  --bs-border-radius-lg: 1.25rem;
+  --bs-border-radius-sm: 0.5rem;
+  --bs-primary: #f5a524;
+  --bs-primary-rgb: 245, 165, 36;
+  --bs-link-color-rgb: 245, 165, 36;
+  --bs-link-hover-color-rgb: 255, 190, 80;
+}
+
+html[data-bs-theme=dark] {
+  --bs-body-bg: #0e0f11;
+  --bs-body-bg-rgb: 14, 15, 17;
+  --bs-body-color: #ecedef;
+  --bs-body-color-rgb: 236, 237, 239;
+  --bs-secondary-color: #9b9ea6;
+  --bs-secondary-bg: #1e1f23;
+  --bs-tertiary-bg: #16171a;
+  --bs-tertiary-bg-rgb: 22, 23, 26;
+  --bs-emphasis-color: #ffffff;
+  --bs-border-color: #2b2d32;
+  --bs-card-bg: #16171a;
+  --bs-success: #5bcb8a;
+  --bs-success-rgb: 91, 203, 138;
+  --bs-primary-text-emphasis: #f5a524;
+  --bs-primary-bg-subtle: #3a2a08;
+  --bs-primary-border-subtle: #6b4a10;
+}
+
+html[data-bs-theme=light] {
+  --bs-body-bg: #f3f2ee;
+  --bs-body-bg-rgb: 243, 242, 238;
+  --bs-body-color: #1a1b1e;
+  --bs-body-color-rgb: 26, 27, 30;
+  --bs-secondary-color: #5e6068;
+  --bs-secondary-bg: #eae8e2;
+  --bs-tertiary-bg: #ffffff;
+  --bs-tertiary-bg-rgb: 255, 255, 255;
+  --bs-border-color: #ddd9d0;
+  --bs-card-bg: #ffffff;
+  --bs-success: #1e7a44;
+  --bs-success-rgb: 30, 122, 68;
+  --bs-primary-text-emphasis: #8a5200;
+  --bs-primary-bg-subtle: #ffe9c2;
+  --bs-primary-border-subtle: #f5c777;
+  --bs-link-color-rgb: 138, 82, 0;
+  --bs-link-hover-color-rgb: 100, 60, 0;
+}
+
+html body {
+  font-family: var(--bs-font-sans-serif);
+  background-color: var(--bs-body-bg);
+}
+
+html h1, html h2, html h3, html h4, html h5, html h6 { font-weight: 600; letter-spacing: -0.2px; }
+
+/* The one amber action: solid buttons use the accent with dark text, in both themes. */
+html .btn-primary, html .btn-success {
+  --bs-btn-color: #1a1204;
+  --bs-btn-bg: #f5a524;
+  --bs-btn-border-color: #f5a524;
+  --bs-btn-hover-color: #1a1204;
+  --bs-btn-hover-bg: #ffb64a;
+  --bs-btn-hover-border-color: #ffb64a;
+  --bs-btn-active-color: #1a1204;
+  --bs-btn-active-bg: #e6961a;
+  --bs-btn-active-border-color: #e6961a;
+  --bs-btn-disabled-color: #1a1204;
+  --bs-btn-disabled-bg: #f5a524;
+  --bs-btn-disabled-border-color: #f5a524;
+  font-weight: 600;
+}
+
+html .btn-outline-primary, html .btn-outline-secondary {
+  --bs-btn-color: var(--bs-body-color);
+  --bs-btn-border-color: var(--bs-border-color);
+  --bs-btn-hover-color: var(--bs-body-color);
+  --bs-btn-hover-bg: var(--bs-secondary-bg);
+  --bs-btn-hover-border-color: var(--bs-border-color);
+  --bs-btn-active-color: var(--bs-body-color);
+  --bs-btn-active-bg: var(--bs-secondary-bg);
+  --bs-btn-active-border-color: var(--bs-border-color);
+}
+
+html .card, html .list-group, html .list-group-item {
+  --bs-card-bg: var(--bs-tertiary-bg);
+  --bs-list-group-bg: var(--bs-tertiary-bg);
+  --bs-list-group-border-color: var(--bs-border-color);
+  border-color: var(--bs-border-color);
+  box-shadow: none;
+}
+
+html .form-control, html .form-select {
+  background-color: var(--bs-body-bg);
+  border-color: var(--bs-border-color);
+}
+html .form-control:focus, html .form-select:focus {
+  border-color: #f5a524;
+  box-shadow: 0 0 0 0.2rem rgba(245, 165, 36, 0.2);
+}
+html .form-check-input:checked { background-color: #f5a524; border-color: #f5a524; }
+
+html .navbar { background-color: var(--bs-body-bg) !important; border-bottom: 1px solid var(--bs-border-color); }
+html .navbar-brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 600; }
+html .navbar-brand .duvo-mark { height: 30px; width: auto; }
+
+html code, html kbd, html pre, html .font-monospace { font-family: var(--bs-font-monospace); }
+
+html .alert-info { --bs-alert-bg: var(--bs-secondary-bg); --bs-alert-color: var(--bs-body-color); --bs-alert-border-color: var(--bs-border-color); }
+html .alert-warning { --bs-alert-bg: var(--bs-primary-bg-subtle); --bs-alert-color: var(--bs-primary-text-emphasis); --bs-alert-border-color: var(--bs-primary-border-subtle); }
