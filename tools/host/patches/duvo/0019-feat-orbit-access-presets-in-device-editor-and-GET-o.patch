diff --git a/tests/unit/test_status_tracker.cpp b/tests/unit/test_status_tracker.cpp
index 2cec7f70..5d7a25bb 100644
--- a/tests/unit/test_status_tracker.cpp
+++ b/tests/unit/test_status_tracker.cpp
@@ -24,6 +24,7 @@
 #include <nlohmann/json.hpp>
 #include <optional>
 #include <src/orbit/api_routes.h>
+#include <src/orbit/client_perm.h>
 #include <src/orbit/status_tracker.h>
 
 using namespace std::chrono_literals;
@@ -221,3 +222,14 @@ TEST(OrbitApi, EventsParamsRequireViewAndClampTimeout) {
   EXPECT_EQ(orbit::parse_events_request(&viewer, {{"since", "abc"}}).error_status, 400);
   EXPECT_EQ(orbit::parse_events_request(&viewer, {{"since", "1"}, {"timeout", "-4"}}).error_status, 400);
 }
+
+TEST(OrbitApi, AccessReturnsOwnPermission) {
+  EXPECT_EQ(orbit::access_reply(nullptr).status, 401);
+  crypto::named_cert_t c {};
+  c.perm = orbit::kQrPairedPerm;
+  auto r = orbit::access_reply(&c);
+  EXPECT_EQ(r.status, 200);
+  EXPECT_EQ(nlohmann::json::parse(r.body)["perm"].get<uint32_t>(), static_cast<uint32_t>(orbit::kQrPairedPerm));
+  c.perm = crypto::PERM::_no;  // a disabled device still learns it has nothing
+  EXPECT_EQ(nlohmann::json::parse(orbit::access_reply(&c).body)["perm"].get<uint32_t>(), 0u);
+}
