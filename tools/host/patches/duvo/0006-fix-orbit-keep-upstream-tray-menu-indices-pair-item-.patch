From 9e331bb0d9669d418e491ab28d96b8d4179c2457 Mon Sep 17 00:00:00 2001
From: Duvo <duvo@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:14:38 -0300
Subject: [PATCH 06/28] fix(orbit): keep upstream tray menu indices (pair item
 after force-stop)

update_tray_playing/stopped write tray.menu[2]; inserting the Orbit item at
index 1 made every stream overwrite the separator instead of force-stop.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/system_tray.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/system_tray.cpp b/src/system_tray.cpp
index 7cfe8a03..87559fe5 100644
--- a/src/system_tray.cpp
+++ b/src/system_tray.cpp
@@ -122,7 +122,6 @@ namespace system_tray {
       (struct tray_menu[]) {
         // todo - use boost/locale to translate menu strings
         { .text = "Open Apollo", .cb = tray_open_ui_cb },
-        { .text = "Parear celular...", .cb = tray_pair_phone_cb },  // ORBIT:
         { .text = "-" },
         // { .text = "-" },
         // { .text = "Donate",
@@ -135,6 +134,8 @@ namespace system_tray {
         //       { .text = nullptr } } },
         // { .text = "-" },
         { .text = TRAY_MSG_NO_APP_RUNNING, .cb = tray_force_stop_cb },
+        // ORBIT: depois do force-stop para manter os indices upstream 0-2 (menu[2] = force-stop)
+        { .text = "Parear celular...", .cb = tray_pair_phone_cb },
   // Currently display device settings are only supported on Windows
   #ifdef _WIN32
         {.text = "Reset Display Device Config", .cb = tray_reset_display_device_config_cb},
-- 
