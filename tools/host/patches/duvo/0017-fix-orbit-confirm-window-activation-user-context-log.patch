+    bool is_visible(uint64_t) override { return visible; }
+    bool is_host_window(uint64_t) override { return host; }
+    bool higher_integrity(uint64_t) override { return elevated; }
+    bool is_minimized(uint64_t) override { return minimized; }
+    void restore(uint64_t) override { minimized = false; }
+
+    bool set_foreground(uint64_t) override {
+      auto i = std::min<size_t>(set_fg_calls++, set_fg_results.size() - 1);
+      return set_fg_results[i];
+    }
+
+    void nudge_foreground_lock() override { ++nudges; }
+
+    uint64_t foreground_root() override {
+      return (fg_after_ms >= 0 && slept >= fg_after_ms) ? kTarget : fg;
+    }
+
+    void sleep_ms(int ms) override { slept += ms; }
+
+    bool running_as_system() override { return system; }
+
+    bool run_as_user(const std::string &cmd) override {
+      user_cmds.push_back(cmd);
+      return true;
+    }
+
+    bool initiate_shutdown(bool reboot) override {
+      (reboot ? reboots : shutdowns)++;
+      return true;
+    }
+
+    bool suspend() override { return ++suspends > 0; }
+    bool exit_windows_logoff() override { return ++exit_logoffs > 0; }
+    bool lock_workstation() override { return ++locks > 0; }
+    std::string system_dir() override { return "C:\\Windows\\System32"; }
+    std::string windows_dir() override { return "C:\\Windows"; }
+  };
+}  // namespace
