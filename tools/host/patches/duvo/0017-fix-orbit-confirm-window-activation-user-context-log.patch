+TEST(WinActions, ActivateOkWhenForegroundMatches) {
+  FakeOs os;
+  os.fg_after_ms = 0;
+  EXPECT_EQ(orbit::activate_window(os, kTarget), orbit::ActivateResult::ok);
+
+  FakeOs late;
+  late.fg_after_ms = 100;  // becomes foreground a bit later: still ok
+  EXPECT_EQ(orbit::activate_window(late, kTarget), orbit::ActivateResult::ok);
+}
+
+TEST(WinActions, ActivateDeniedWhenForegroundNeverMatches) {
+  FakeOs os;
+  os.fg = 0x2000;  // a full-screen game keeps the foreground even though SetForegroundWindow said TRUE
+  EXPECT_EQ(orbit::activate_window(os, kTarget), orbit::ActivateResult::denied);
+  EXPECT_GE(os.slept, orbit::kForegroundConfirmMs);
+  EXPECT_LE(os.slept, orbit::kForegroundConfirmMs + orbit::kForegroundPollMs);
+}
+
+TEST(WinActions, ActivateRetriesOnceAfterNudge) {
+  FakeOs os;
+  os.set_fg_results = {false, true};
+  os.fg_after_ms = 0;
+  EXPECT_EQ(orbit::activate_window(os, kTarget), orbit::ActivateResult::ok);
+  EXPECT_EQ(os.nudges, 1);
+
+  FakeOs refused;
+  refused.set_fg_results = {false};
+  EXPECT_EQ(orbit::activate_window(refused, kTarget), orbit::ActivateResult::denied);
+  EXPECT_EQ(refused.set_fg_calls, 2);
+}
+
+TEST(WinActions, ActivateRestoresMinimized) {
+  FakeOs os;
+  os.minimized = true;
+  os.fg_after_ms = 0;
+  EXPECT_EQ(orbit::activate_window(os, kTarget), orbit::ActivateResult::ok);
+  EXPECT_FALSE(os.minimized);
+}
+
+TEST(WinActions, ActivateRejectsChildHiddenAndHostWindows) {
+  {
+    FakeOs os;
+    os.window = false;
+    EXPECT_EQ(orbit::activate_window(os, kTarget), orbit::ActivateResult::not_found);
+    EXPECT_EQ(orbit::activate_window(os, 0), orbit::ActivateResult::not_found);
+  }
+  {
+    FakeOs os;
+    os.top_level = false;  // child window
+    EXPECT_EQ(orbit::activate_window(os, kTarget), orbit::ActivateResult::not_found);
+    EXPECT_EQ(os.set_fg_calls, 0);
+  }
+  {
+    FakeOs os;
+    os.visible = false;
+    EXPECT_EQ(orbit::activate_window(os, kTarget), orbit::ActivateResult::not_found);
+    EXPECT_EQ(os.set_fg_calls, 0);
+  }
+  {
+    FakeOs os;
+    os.host = true;
+    EXPECT_EQ(orbit::activate_window(os, kTarget), orbit::ActivateResult::not_found);
+    EXPECT_EQ(os.set_fg_calls, 0);
+  }
+  {
+    FakeOs os;
+    os.elevated = true;
+    EXPECT_EQ(orbit::activate_window(os, kTarget), orbit::ActivateResult::denied);
+    EXPECT_EQ(os.set_fg_calls, 0);
+  }
+}
