+/**
+ * @file src/orbit/win_actions.cpp
+ * @brief Window activation and power decisions (platform independent; Win32 calls go through Win32Ops).
+ */
+#include "win_actions.h"
+
+#include "src/logging.h"
+
+namespace orbit {
+  std::string quoted_path(const std::string &dir, const std::string &exe) {
+    return "\"" + dir + "\\" + exe + "\"";
+  }
+
+  ActivateResult activate_window(Win32Ops &os, uint64_t id) {
+    if (id == 0 || !os.is_window(id)) {
+      return ActivateResult::not_found;
+    }
+    // Same set as the window list: never child, hidden or host-owned windows.
+    if (!os.is_top_level(id) || !os.is_visible(id) || os.is_host_window(id)) {
+      return ActivateResult::not_found;
+    }
+    if (os.higher_integrity(id)) {
+      return ActivateResult::denied;
+    }
+    if (os.is_minimized(id)) {
+      os.restore(id);
+      for (int i = 0; i < 20 && os.is_minimized(id); ++i) {
+        os.sleep_ms(10);
+      }
+    }
+
+    bool accepted = os.set_foreground(id);
+    if (!accepted) {
+      // Foreground lock: only the process that got the last input may switch; an empty input makes it us.
+      os.nudge_foreground_lock();
+      accepted = os.set_foreground(id);
+    }
+    if (!accepted) {
+      BOOST_LOG(info) << "[Orbit] SetForegroundWindow refused for window " << id;
+      return ActivateResult::denied;
+    }
+
+    // TRUE does not guarantee the switch (e.g. a full-screen game keeps the foreground): confirm it.
+    for (int waited = 0;; waited += kForegroundPollMs) {
+      if (os.foreground_root() == id) {
+        return ActivateResult::ok;
+      }
+      if (waited >= kForegroundConfirmMs) {
+        break;
+      }
+      os.sleep_ms(kForegroundPollMs);
+    }
+    BOOST_LOG(info) << "[Orbit] window " << id << " did not become the foreground window";
+    return ActivateResult::denied;
+  }
+
+  bool run_power_action(Win32Ops &os, PowerAction action) {
+    switch (action) {
+      case PowerAction::shutdown:
+        return os.initiate_shutdown(false);
+      case PowerAction::restart:
+        return os.initiate_shutdown(true);
+      case PowerAction::sleep:
+        return os.suspend();
+      case PowerAction::logoff:
+        // As SYSTEM, log off from inside the user's session (shutdown /l -> ExitWindowsEx), so apps with
+        // unsaved work can still veto, like the non-SYSTEM path. WTSLogoffSession would force it.
+        return os.running_as_system() ? os.run_as_user(quoted_path(os.system_dir(), "shutdown.exe") + " /l") : os.exit_windows_logoff();
+      case PowerAction::lock:
+        // LockWorkStation only works from the user's interactive session.
+        return os.running_as_system() ? os.run_as_user(quoted_path(os.system_dir(), "rundll32.exe") + " user32.dll,LockWorkStation") : os.lock_workstation();
+    }
+    return false;
+  }
+}  // namespace orbit
