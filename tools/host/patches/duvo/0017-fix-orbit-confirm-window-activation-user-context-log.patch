+TEST(WinActions, LogoffAsSystemUsesUserContext) {
+  FakeOs os;
+  os.system = true;
+  EXPECT_TRUE(orbit::run_power_action(os, orbit::PowerAction::logoff));
+  ASSERT_EQ(os.user_cmds.size(), 1u);
+  EXPECT_EQ(os.user_cmds[0], "\"C:\\Windows\\System32\\shutdown.exe\" /l");
+  EXPECT_EQ(os.exit_logoffs, 0);
+
+  FakeOs user;
+  EXPECT_TRUE(orbit::run_power_action(user, orbit::PowerAction::logoff));
+  EXPECT_EQ(user.exit_logoffs, 1);
+  EXPECT_TRUE(user.user_cmds.empty());
+}
+
+TEST(WinActions, LockAsSystemUsesAbsoluteRundll32) {
+  FakeOs os;
+  os.system = true;
+  EXPECT_TRUE(orbit::run_power_action(os, orbit::PowerAction::lock));
+  ASSERT_EQ(os.user_cmds.size(), 1u);
+  EXPECT_EQ(os.user_cmds[0], "\"C:\\Windows\\System32\\rundll32.exe\" user32.dll,LockWorkStation");
+  EXPECT_EQ(os.locks, 0);
+
+  FakeOs user;
+  EXPECT_TRUE(orbit::run_power_action(user, orbit::PowerAction::lock));
+  EXPECT_EQ(user.locks, 1);
+}
+
+TEST(WinActions, ShutdownRestartSleepMapToPlatform) {
+  FakeOs os;
+  EXPECT_TRUE(orbit::run_power_action(os, orbit::PowerAction::shutdown));
+  EXPECT_TRUE(orbit::run_power_action(os, orbit::PowerAction::restart));
+  EXPECT_TRUE(orbit::run_power_action(os, orbit::PowerAction::sleep));
+  EXPECT_EQ(os.shutdowns, 1);
+  EXPECT_EQ(os.reboots, 1);
+  EXPECT_EQ(os.suspends, 1);
+  EXPECT_TRUE(os.user_cmds.empty());
+}
