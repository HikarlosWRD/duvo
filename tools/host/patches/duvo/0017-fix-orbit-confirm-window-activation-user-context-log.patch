+/**
+ * @file src/orbit/win_actions.h
+ * @brief Window activation and power decisions over a thin Win32 seam (Win32Ops), so they can be tested with fakes.
+ */
+#pragma once
+
+#include "power_api.h"
+#include "windows_api.h"
+
+#include <cstdint>
+#include <string>
+
+namespace orbit {
+  /// Primitive Win32 calls used by activate_window / run_power_action. Window ids are HWND values.
+  class Win32Ops {
+  public:
+    virtual ~Win32Ops() = default;
+
+    // windows
+    virtual bool is_window(uint64_t id) = 0;
+    virtual bool is_top_level(uint64_t id) = 0;  ///< GetAncestor(h, GA_ROOT) == h
+    virtual bool is_visible(uint64_t id) = 0;
+    virtual bool is_host_window(uint64_t id) = 0;  ///< owned by the host process
+    virtual bool higher_integrity(uint64_t id) = 0;  ///< target process above the host's integrity level
+    virtual bool is_minimized(uint64_t id) = 0;
+    virtual void restore(uint64_t id) = 0;  ///< asynchronous restore
+    virtual bool set_foreground(uint64_t id) = 0;
+    virtual void nudge_foreground_lock() = 0;  ///< empty input event so SetForegroundWindow is allowed
+    virtual uint64_t foreground_root() = 0;  ///< GetAncestor(GetForegroundWindow(), GA_ROOT)
+    virtual void sleep_ms(int ms) = 0;
+
+    // power / processes
+    virtual bool running_as_system() = 0;
+    virtual bool run_as_user(const std::string &cmd) = 0;  ///< start a command in the logged-in user's context
+    virtual bool initiate_shutdown(bool reboot) = 0;  ///< not forced: apps can still veto
+    virtual bool suspend() = 0;
+    virtual bool exit_windows_logoff() = 0;  ///< ExitWindowsEx(EWX_LOGOFF) in our own session
+    virtual bool lock_workstation() = 0;
+    virtual std::string system_dir() = 0;  ///< e.g. C:\Windows\System32 (UTF-8, no trailing slash)
+    virtual std::string windows_dir() = 0;  ///< e.g. C:\Windows
+  };
+
+  /// How long activate waits for the foreground to really become the target after SetForegroundWindow.
+  inline constexpr int kForegroundConfirmMs = 300;
+  inline constexpr int kForegroundPollMs = 20;
+
+  /**
+   * @brief Activate a window: only visible top-level windows not owned by the host (else not_found);
+   * denied for higher-integrity targets, when SetForegroundWindow refuses, or when the foreground does not
+   * become the target within kForegroundConfirmMs.
+   */
+  ActivateResult activate_window(Win32Ops &os, uint64_t id);
+
+  /// Run a power action. Logoff and lock go through the user's context when the host runs as SYSTEM.
+  bool run_power_action(Win32Ops &os, PowerAction action);
+
+  /// `"<dir>\<exe>"` quoted, for run_as_user commands.
+  std::string quoted_path(const std::string &dir, const std::string &exe);
+}  // namespace orbit
