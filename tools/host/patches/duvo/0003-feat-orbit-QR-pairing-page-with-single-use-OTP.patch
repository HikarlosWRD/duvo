+/**
+ * @file src/orbit/otp_slot.cpp
+ * @brief Single-use, time-limited OTP slot.
+ */
+#include "otp_slot.h"
+
+namespace orbit {
+  void OtpSlot::issue(std::string pin, std::string passphrase, std::string device_name, clock::time_point now) {
+    otp_ = Otp {std::move(pin), std::move(passphrase), std::move(device_name), now};
+  }
+
+  const OtpSlot::Otp *OtpSlot::peek(clock::time_point now) {
+    if (!otp_) {
+      return nullptr;
+    }
+    if (otp_->pin.empty() || now - otp_->created > ttl_) {
+      otp_.reset();
+      return nullptr;
+    }
+    return &*otp_;
+  }
+
+  std::optional<OtpSlot::Otp> OtpSlot::take(clock::time_point now) {
+    if (!peek(now)) {
+      return std::nullopt;
+    }
+    auto out = std::move(otp_);
+    otp_.reset();
+    return out;
+  }
+
+  void OtpSlot::clear() {
+    otp_.reset();
+  }
+}  // namespace orbit
