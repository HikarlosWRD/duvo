+/**
+ * @file src/orbit/pair_service.cpp
+ * @brief Creates the OTP and the pairing URI shown as a QR.
+ */
+#include "pair_service.h"
+
+#include "pair_qr.h"
+#include "src/config.h"
+#include "src/crypto.h"
+#include "src/file_handler.h"
+#include "src/network.h"
+#include "src/nvhttp.h"
+
+#include <chrono>
+#include <stdexcept>
+
+namespace orbit {
+  namespace {
+    std::string cert_sha256_hex() {
+      auto pem = file_handler::read_file(config::nvhttp.cert.c_str());
+      auto x = crypto::x509(pem);
+      if (!x) {
+        throw std::runtime_error("host certificate unavailable");
+      }
+      unsigned char *der = nullptr;
+      int len = i2d_X509(x.get(), &der);
+      if (len <= 0) {
+        throw std::runtime_error("host certificate unreadable");
+      }
+      auto digest = crypto::hash(std::string_view {reinterpret_cast<char *>(der), static_cast<size_t>(len)});
+      OPENSSL_free(der);
+
+      static const char *hex = "0123456789abcdef";
+      std::string out;
+      for (auto b : digest) {
+        out += hex[b >> 4];
+        out += hex[b & 0xF];
+      }
+      return out;
+    }
+  }  // namespace
+
+  PairQr create_pair_qr() {
+    using namespace std::literals;
+    // URL-safe alphabet, 24 chars (~142 bits)
+    auto passphrase = crypto::rand_alphabet(24, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"sv);
+    auto otp = nvhttp::request_otp(passphrase, "");
+    if (otp.empty()) {
+      throw std::runtime_error("could not create OTP");
+    }
+    auto expires = std::chrono::duration_cast<std::chrono::seconds>(std::chrono::system_clock::now().time_since_epoch() + nvhttp::OTP_EXPIRE_DURATION).count();
+
+    auto ips = usable_ipv4(list_adapters());
+    if (ips.empty()) {
+      throw std::runtime_error("no usable network address");
+    }
+
+    return {build_pair_uri(ips, static_cast<int>(net::map_port(nvhttp::PORT_HTTP)), otp, passphrase, cert_sha256_hex(), config::nvhttp.sunshine_name), expires};
+  }
+}  // namespace orbit
