+/**
+ * @file src/orbit/adapters.cpp
+ * @brief Local network adapter enumeration.
+ */
+#include "pair_qr.h"
+
+#ifdef _WIN32
+  #include <winsock2.h>
+  #include <ws2tcpip.h>
+  // keep include order: winsock2 before iphlpapi
+  #include <iphlpapi.h>
+
+  #include <vector>
+#endif
+
+namespace orbit {
+#ifdef _WIN32
+  std::vector<Adapter> list_adapters() {
+    std::vector<Adapter> out;
+    ULONG len = 15 * 1024;
+    std::vector<unsigned char> buf;
+    ULONG rc = ERROR_BUFFER_OVERFLOW;
+    for (int attempt = 0; attempt < 3 && rc == ERROR_BUFFER_OVERFLOW; ++attempt) {
+      buf.resize(len);
+      rc = GetAdaptersAddresses(AF_INET, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER, nullptr, reinterpret_cast<PIP_ADAPTER_ADDRESSES>(buf.data()), &len);
+    }
+    if (rc != NO_ERROR) {
+      return out;
+    }
+
+    for (auto *a = reinterpret_cast<PIP_ADAPTER_ADDRESSES>(buf.data()); a; a = a->Next) {
+      Adapter::Kind kind = Adapter::Kind::Other;
+      if (a->IfType == IF_TYPE_ETHERNET_CSMACD) {
+        kind = Adapter::Kind::Ethernet;
+      } else if (a->IfType == IF_TYPE_IEEE80211) {
+        kind = Adapter::Kind::WiFi;
+      }
+
+      // Friendly name is wide; reduce to ASCII (only used for virtual-adapter matching)
+      std::string name;
+      for (const wchar_t *w = a->FriendlyName; w && *w; ++w) {
+        name += (*w < 128) ? static_cast<char>(*w) : '?';
+      }
+
+      for (auto *u = a->FirstUnicastAddress; u; u = u->Next) {
+        if (!u->Address.lpSockaddr || u->Address.lpSockaddr->sa_family != AF_INET) {
+          continue;
+        }
+        char ip[INET_ADDRSTRLEN] {};
+        auto *sin = reinterpret_cast<sockaddr_in *>(u->Address.lpSockaddr);
+        if (!InetNtopA(AF_INET, &sin->sin_addr, ip, sizeof(ip))) {
+          continue;
+        }
+        out.push_back({name, ip, a->OperStatus == IfOperStatusUp, a->IfType == IF_TYPE_SOFTWARE_LOOPBACK, kind});
+      }
+    }
+    return out;
+  }
+#else
+  std::vector<Adapter> list_adapters() {
+    return {};
+  }
+#endif
+}  // namespace orbit
