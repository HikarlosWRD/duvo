+/**
+ * @file src/orbit/otp_slot.h
+ * @brief Single-use, time-limited OTP slot (clock injectable for tests).
+ */
+#pragma once
+
+#include <chrono>
+#include <optional>
+#include <string>
+
+namespace orbit {
+  /**
+   * @brief Holds at most one pending OTP. Valid for ttl (Apollo: 180 s) and consumable once.
+   */
+  class OtpSlot {
+  public:
+    using clock = std::chrono::steady_clock;
+
+    struct Otp {
+      std::string pin;
+      std::string passphrase;
+      std::string device_name;
+      clock::time_point created;
+    };
+
+    explicit OtpSlot(std::chrono::seconds ttl = std::chrono::seconds {180}):
+        ttl_ {ttl} {}
+
+    /// Replace any pending OTP.
+    void issue(std::string pin, std::string passphrase, std::string device_name, clock::time_point now);
+
+    /// The pending OTP if still valid at `now`; an expired one is wiped and nullptr returned.
+    const Otp *peek(clock::time_point now);
+
+    /// Return the pending OTP if valid and clear it (single use).
+    std::optional<Otp> take(clock::time_point now);
+
+    void clear();
+
+  private:
+    std::chrono::seconds ttl_;
+    std::optional<Otp> otp_;
+  };
+}  // namespace orbit
