+  AdbResult Service::devices_result(std::vector<AdbDevice> &out) {
+    auto r = impl_->run_adb({"devices", "-l"}, 12s);
+    if (r.ok) {
+      out = parse_devices(r.output);
+    }
+    return r;
+  }
+
+  AdbResult Service::disconnect(const std::string &serial) {
+    if (!valid_serial(serial)) {
+      return {false, "invalid"};
+    }
+    return impl_->run_adb({"disconnect", serial}, 10s);
+  }
+
+  AdbResult Service::rotate(const std::string &serial) {
+    if (!valid_serial(serial)) {
+      return {false, "invalid"};
+    }
+    auto cur = impl_->run_adb({"-s", serial, "shell", "settings", "get", "system", "user_rotation"}, 10s);
+    if (!cur.ok) {
+      return cur;
+    }
+    int rot = 0;
+    try {
+      rot = std::stoi(cur.output);
+    } catch (...) {
+    }
+    impl_->run_adb({"-s", serial, "shell", "settings", "put", "system", "accelerometer_rotation", "0"}, 10s);
+    return impl_->run_adb({"-s", serial, "shell", "settings", "put", "system", "user_rotation", std::to_string((rot + 1) % 4)}, 10s);
+  }
+
