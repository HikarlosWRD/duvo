+  /// ORBIT: forget a wireless device. Body: {"serial": "..."}
+  void orbitReverseDisconnect(resp_https_t response, req_https_t request) {
+    nlohmann::json body;
+    if (!reverse_prologue(response, request, body)) {
+      return;
+    }
+    auto serial = body.value("serial", "");
+    reverse_service().stop(serial);
+    auto r = reverse_service().disconnect(serial);
+    send_response(response, nlohmann::json {{"ok", r.ok}, {"output", r.output}});
+  }
+
+  /// ORBIT: rotate the phone screen. Body: {"serial": "..."}
+  void orbitReverseRotate(resp_https_t response, req_https_t request) {
+    nlohmann::json body;
+    if (!reverse_prologue(response, request, body)) {
+      return;
+    }
+    auto r = reverse_service().rotate(body.value("serial", ""));
+    send_response(response, nlohmann::json {{"ok", r.ok}, {"output", r.output}});
+  }
+
   /// ORBIT: close the phone window. Body: {"serial": "..."}
   void orbitReverseStop(resp_https_t response, req_https_t request) {
     nlohmann::json body;
