From db515c17737dd14bff3b23aab1473c9f714cbd80 Mon Sep 17 00:00:00 2001
From: Duvo <duvo@users.noreply.github.com>
Date: Tue, 17 Nov 2026 20:48:32 -0300
Subject: [PATCH 01/28] fix(build): OpenSSL 4 compat and missing cfg.profile

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/crypto.cpp | 6 ++++--
 src/video.cpp  | 3 +--
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/src/crypto.cpp b/src/crypto.cpp
index 97acd805..10802f29 100644
--- a/src/crypto.cpp
+++ b/src/crypto.cpp
@@ -385,7 +385,8 @@ namespace crypto {
     const ASN1_BIT_STRING *asn1 = nullptr;
     X509_get0_signature(&asn1, nullptr, x.get());
 
-    return {(const char *) asn1->data, (std::size_t) asn1->length};
+    // ORBIT: OpenSSL 4 torna ASN1_BIT_STRING opaco; usar acessores
+    return {(const char *) ASN1_STRING_get0_data(asn1), (std::size_t) ASN1_STRING_length(asn1)};
   }
 
   std::string rand(std::size_t bytes) {
@@ -455,7 +456,8 @@ namespace crypto {
 
     X509_set_pubkey(x509.get(), pkey.get());
 
-    auto name = X509_get_subject_name(x509.get());
+    // ORBIT: OpenSSL 4 retorna const X509_NAME*
+    auto name = const_cast<X509_NAME *>(X509_get_subject_name(x509.get()));
     X509_NAME_add_entry_by_txt(name, "CN", MBSTRING_ASC, (const std::uint8_t *) cn.data(), cn.size(), -1, 0);
 
     X509_set_issuer_name(x509.get(), name);
diff --git a/src/video.cpp b/src/video.cpp
index fc0b0efe..8b53d877 100644
--- a/src/video.cpp
+++ b/src/video.cpp
@@ -827,8 +827,7 @@ namespace video {
       {
         // SDR-specific options
         {"profile"s, [](const config_t &cfg) {
-           if (cfg.profile == 66) return "baseline"s;
-           if (cfg.profile == 77) return "main"s;
+           // ORBIT: config_t do Apollo nao tem 'profile' (bug upstream master); sempre "high"
            return "high"s;
          }},
       },
-- 
2.55.0.windows.5

