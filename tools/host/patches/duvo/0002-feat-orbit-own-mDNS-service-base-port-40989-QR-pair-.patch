+/**
+ * @file src/orbit/pair_qr.h
+ * @brief Pairing QR payload and usable-IPv4 selection for Orbit.
+ */
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace orbit {
+  struct Adapter {
+    std::string name;
+    std::string ipv4;
+    bool up;
+    bool loopback;
+    enum class Kind { Ethernet, WiFi, Other } kind;
+  };
+
+  /**
+   * @brief Filter adapters to those usable for pairing: up, not loopback, not link-local
+   *        (169.254/16), not a known virtual adapter. Ethernet first, then Wi-Fi, then Other.
+   */
+  std::vector<std::string> usable_ipv4(const std::vector<Adapter> &adapters);
+
+  /**
+   * @brief Build orbit://pair?v=1&h=<ips>&p=<port>&otp=<otp>&fp=<sha256hex>&n=<url-encoded name>
+   */
+  std::string build_pair_uri(const std::vector<std::string> &ips, int port, const std::string &otp, const std::string &cert_sha256_hex, const std::string &host_name);
+}  // namespace orbit
