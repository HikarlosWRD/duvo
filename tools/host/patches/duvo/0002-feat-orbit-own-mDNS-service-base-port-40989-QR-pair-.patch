--- /dev/null
+++ b/tests/unit/test_pair_qr.cpp
@@ -0,0 +1,47 @@
+/**
+ * @file tests/unit/test_pair_qr.cpp
+ * @brief Test src/orbit/pair_qr.*
+ */
+#include "../tests_common.h"
+
+#include <src/orbit/pair_qr.h>
+
+using orbit::Adapter;
+
+TEST(PairQr, UsableIpsFiltersVirtualAndLinkLocal) {
+  std::vector<Adapter> in {
+    {"Wi-Fi", "192.168.0.11", true, false, Adapter::Kind::WiFi},
+    {"vEthernet (WSL)", "172.20.0.1", true, false, Adapter::Kind::Ethernet},
+    {"Ethernet", "192.168.0.10", true, false, Adapter::Kind::Ethernet},
+    {"Ethernet 2", "169.254.3.4", true, false, Adapter::Kind::Ethernet},
+    {"Loopback", "127.0.0.1", true, true, Adapter::Kind::Other},
+    {"Ethernet 3", "10.0.0.5", false, false, Adapter::Kind::Ethernet},
+    {"VMware Network Adapter", "192.168.56.1", true, false, Adapter::Kind::Other},
+  };
+  EXPECT_EQ(orbit::usable_ipv4(in), (std::vector<std::string> {"192.168.0.10", "192.168.0.11"}));
+}
+
+TEST(PairQr, OrdersEthernetWifiOtherKeepingInputOrder) {
+  std::vector<Adapter> in {
+    {"Other", "10.0.0.9", true, false, Adapter::Kind::Other},
+    {"Wi-Fi", "192.168.0.11", true, false, Adapter::Kind::WiFi},
+    {"Eth A", "192.168.0.10", true, false, Adapter::Kind::Ethernet},
+    {"Eth B", "192.168.0.12", true, false, Adapter::Kind::Ethernet},
+  };
+  EXPECT_EQ(orbit::usable_ipv4(in), (std::vector<std::string> {"192.168.0.10", "192.168.0.12", "192.168.0.11", "10.0.0.9"}));
+}
+
+TEST(PairQr, BuildsUri) {
+  std::string fp(64, 'a');
+  for (size_t i = 1; i < fp.size(); i += 2) {
+    fp[i] = 'b';
+  }
+  EXPECT_EQ(
+    orbit::build_pair_uri({"192.168.0.10", "192.168.0.11"}, 40989, "1234", fp, "PC Sala"),
+    "orbit://pair?v=1&h=192.168.0.10,192.168.0.11&p=40989&otp=1234&fp=" + fp + "&n=PC%20Sala"
+  );
+}
+
+TEST(PairQr, EncodesUtf8Name) {
+  EXPECT_EQ(orbit::build_pair_uri({"1.2.3.4"}, 1, "0", "ab", "Cão-1_~.x"), "orbit://pair?v=1&h=1.2.3.4&p=1&otp=0&fp=ab&n=C%C3%A3o-1_~.x");
+}
