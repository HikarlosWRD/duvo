+/**
+ * @file src/orbit/pair_qr.cpp
+ * @brief Pairing QR payload and usable-IPv4 selection for Orbit.
+ */
+#include "pair_qr.h"
+
+#include <algorithm>
+#include <cctype>
+
+namespace orbit {
+  namespace {
+    bool icontains(const std::string &hay, const std::string &needle) {
+      auto it = std::search(hay.begin(), hay.end(), needle.begin(), needle.end(), [](unsigned char a, unsigned char b) {
+        return std::tolower(a) == std::tolower(b);
+      });
+      return it != hay.end();
+    }
+
+    bool is_virtual(const std::string &name) {
+      for (const char *v : {"vEthernet", "VirtualBox", "VMware", "WSL", "Hyper-V"}) {
+        if (icontains(name, v)) {
+          return true;
+        }
+      }
+      return false;
+    }
+
+    bool is_link_local(const std::string &ip) {
+      return ip.rfind("169.254.", 0) == 0;
+    }
+  }  // namespace
+
+  std::vector<std::string> usable_ipv4(const std::vector<Adapter> &adapters) {
+    std::vector<std::string> out;
+    for (auto kind : {Adapter::Kind::Ethernet, Adapter::Kind::WiFi, Adapter::Kind::Other}) {
+      for (const auto &a : adapters) {
+        if (a.kind != kind || !a.up || a.loopback || a.ipv4.empty() || is_link_local(a.ipv4) || is_virtual(a.name)) {
+          continue;
+        }
+        out.push_back(a.ipv4);
+      }
+    }
+    return out;
+  }
+
+  static std::string url_encode(const std::string &s) {
+    static const char *hex = "0123456789ABCDEF";
+    std::string out;
+    for (unsigned char c : s) {
+      if (std::isalnum(c) || c == '-' || c == '.' || c == '_' || c == '~') {
+        out += static_cast<char>(c);
+      } else {
+        out += '%';
+        out += hex[c >> 4];
+        out += hex[c & 0xF];
+      }
+    }
+    return out;
+  }
+
+  std::string build_pair_uri(const std::vector<std::string> &ips, int port, const std::string &otp, const std::string &cert_sha256_hex, const std::string &host_name) {
+    std::string h;
+    for (size_t i = 0; i < ips.size(); ++i) {
+      if (i) {
+        h += ',';
+      }
+      h += ips[i];
+    }
+    return "orbit://pair?v=1&h=" + h + "&p=" + std::to_string(port) + "&otp=" + otp + "&fp=" + cert_sha256_hex + "&n=" + url_encode(host_name);
+  }
+}  // namespace orbit
