+    /// Common prologue of the reverse endpoints: JSON body parsed into [body], false when the request was answered.
+    bool reverse_prologue(resp_https_t &response, req_https_t &request, nlohmann::json &body) {
+      if (!validateContentType(response, request, "application/json") || !authenticate(response, request)) {
+        return false;
+      }
+      print_req(request);
+      body = nlohmann::json::parse(request->content.string(), nullptr, false);
+      if (body.is_discarded() || !body.is_object()) {
+        bad_request(response, request, "Invalid JSON");
+        return false;
+      }
+      return true;
+    }
