+/**
+ * @file tests/unit/test_orbit_reverse.cpp
+ * @brief ORBIT: reverse mode helpers (parsing, validation, command lines).
+ */
+#include "../tests_common.h"
+
+#include <algorithm>
+#include <src/orbit/reverse_mode.h>
+
+using namespace orbit::reverse;
+
+TEST(OrbitReverse, ParsesAdbDevices) {
+  auto d = parse_devices(
+    "* daemon started successfully\r\nList of devices attached\r\n"
+    "192.168.16.101:40123\tdevice product:x model:Vaio_TL10 device:y transport_id:1\r\n"
+    "adb-4AG69W71F-4fzcl1._adb-tls-connect._tcp\tunauthorized\r\n\r\n"
+  );
+  ASSERT_EQ(d.size(), 2u);
+  EXPECT_EQ(d[0].serial, "192.168.16.101:40123");
+  EXPECT_EQ(d[0].state, "device");
+  EXPECT_EQ(d[0].model, "Vaio TL10");
+  EXPECT_EQ(d[1].state, "unauthorized");
+  EXPECT_EQ(d[1].model, "");
+  EXPECT_TRUE(parse_devices("List of devices attached\n\n").empty());
+}
+
+TEST(OrbitReverse, ValidatesInputs) {
+  EXPECT_TRUE(valid_hostport("192.168.1.5:41234"));
+  EXPECT_FALSE(valid_hostport("192.168.1.5"));
+  EXPECT_FALSE(valid_hostport("192.168.1.256:5555"));
+  EXPECT_FALSE(valid_hostport("192.168.1.5:0"));
+  EXPECT_FALSE(valid_hostport("192.168.1.5:70000"));
+  EXPECT_FALSE(valid_hostport("1.2.3.4:5555 & calc"));
+  EXPECT_TRUE(valid_pair_code("123456"));
+  EXPECT_FALSE(valid_pair_code("12345"));
+  EXPECT_FALSE(valid_pair_code("12345a"));
+  EXPECT_TRUE(valid_serial("adb-4AG69W71F-4fzcl1._adb-tls-connect._tcp"));
+  EXPECT_TRUE(valid_serial("192.168.1.5:5555"));
+  EXPECT_FALSE(valid_serial(""));
+  EXPECT_FALSE(valid_serial("a b"));
+  EXPECT_FALSE(valid_serial("a\"&calc"));
+}
+
+TEST(OrbitReverse, BuildsScrcpyArgsWithinRanges) {
+  MirrorOptions o;
+  auto a = scrcpy_args("192.168.1.5:5555", o);
+  EXPECT_EQ(a[0], "-s");
+  EXPECT_EQ(a[1], "192.168.1.5:5555");
+  EXPECT_NE(std::find(a.begin(), a.end(), "--video-bit-rate=8M"), a.end());
+  EXPECT_NE(std::find(a.begin(), a.end(), "--max-fps=60"), a.end());
+  EXPECT_NE(std::find(a.begin(), a.end(), "--stay-awake"), a.end());
+  EXPECT_EQ(std::find(a.begin(), a.end(), "--no-audio"), a.end());
+
+  o.audio = false;
+  o.bitrate_mbps = 9999;
+  o.max_size = 10;
+  o.max_fps = 1;
+  o.turn_screen_off = true;
+  auto b = scrcpy_args("x", o);
+  EXPECT_NE(std::find(b.begin(), b.end(), "--no-audio"), b.end());
+  EXPECT_NE(std::find(b.begin(), b.end(), "--video-bit-rate=100M"), b.end());
+  EXPECT_NE(std::find(b.begin(), b.end(), "--max-size=320"), b.end());
+  EXPECT_NE(std::find(b.begin(), b.end(), "--max-fps=10"), b.end());
+  EXPECT_NE(std::find(b.begin(), b.end(), "--turn-screen-off"), b.end());
+}
+
+TEST(OrbitReverse, QuotesCommandLine) {
+  EXPECT_EQ(quote_command("C:\\a b\\scrcpy.exe", {"-s", "x"}), "\"C:\\a b\\scrcpy.exe\" -s x");
+  EXPECT_EQ(quote_command("a", {"--window-title=Orbit - celular"}), "a \"--window-title=Orbit - celular\"");
+  EXPECT_EQ(quote_command("a", {"say \"hi\""}), "a \"say \\\"hi\\\"\"");
+  EXPECT_EQ(quote_command("a", {"c:\\dir with space\\"}), "a \"c:\\dir with space\\\\\"");
+}
