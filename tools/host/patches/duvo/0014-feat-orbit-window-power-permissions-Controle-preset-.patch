diff --git a/tests/unit/test_client_perm.cpp b/tests/unit/test_client_perm.cpp
index 5f888636..2a4702de 100644
--- a/tests/unit/test_client_perm.cpp
+++ b/tests/unit/test_client_perm.cpp
@@ -37,8 +37,8 @@ TEST(ClientPerm, OtpGetsQrPermsEvenIfFirst) {
   }
 }
 
-TEST(ClientPerm, OtpPermsExcludeServerCmdFilesClipboard) {
-  for (auto p : {PERM::server_cmd, PERM::file_upload, PERM::file_dwnload, PERM::clipboard_read, PERM::clipboard_set}) {
+TEST(ClientPerm, OtpPermsExcludeServerCmdAndFiles) {
+  for (auto p : {PERM::server_cmd, PERM::file_upload, PERM::file_dwnload}) {
     EXPECT_FALSE(has(orbit::kQrPairedPerm, p));
   }
 }
@@ -50,3 +50,37 @@ TEST(ClientPerm, PinPairingFirstGetsAll) {
 TEST(ClientPerm, PinPairingLaterGetsDefault) {
   EXPECT_EQ(orbit::perm_for_new_client(false, false), PERM::_default);
 }
+
+TEST(ClientPerm, ControlePresetBits) {
+  for (auto p : {PERM::orbit_windows, PERM::orbit_power, PERM::clipboard_set, PERM::clipboard_read}) {
+    EXPECT_TRUE(has(orbit::kQrPairedPerm, p));
+  }
+  for (auto p : {PERM::file_upload, PERM::file_dwnload, PERM::server_cmd}) {
+    EXPECT_FALSE(has(orbit::kQrPairedPerm, p));
+  }
+}
+
+TEST(ClientPerm, MigratesOldQrPreset) {
+  EXPECT_EQ(orbit::migrate_perm(static_cast<PERM>(0x07001F00u)), orbit::kQrPairedPerm);
+}
+
+TEST(ClientPerm, KeepsOtherPermsAsIs) {
+  EXPECT_EQ(orbit::migrate_perm(PERM::_default), PERM::_default);
+  EXPECT_EQ(orbit::migrate_perm(PERM::_all), PERM::_all);
+  EXPECT_EQ(orbit::migrate_perm(orbit::kQrPairedPerm), orbit::kQrPairedPerm);
+}
+
+TEST(ClientPerm, NewBitsDoNotCollide) {
+  EXPECT_EQ(static_cast<uint32_t>(PERM::orbit_windows), 1u << 21);
+  EXPECT_EQ(static_cast<uint32_t>(PERM::orbit_power), 1u << 22);
+  EXPECT_TRUE(has(PERM::_all, PERM::orbit_windows));
+  EXPECT_TRUE(has(PERM::_all, PERM::orbit_power));
+}
+
+TEST(ClientPerm, HasPermNullAndSet) {
+  EXPECT_FALSE(orbit::has_perm(nullptr, PERM::orbit_power));
+  crypto::named_cert_t c;
+  c.perm = orbit::kQrPairedPerm;
+  EXPECT_TRUE(orbit::has_perm(&c, PERM::orbit_power));
+  EXPECT_FALSE(orbit::has_perm(&c, PERM::server_cmd));
+}
