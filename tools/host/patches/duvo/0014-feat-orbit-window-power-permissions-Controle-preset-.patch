+      _all_opeiations  = clipboard_set | clipboard_read | file_upload | file_dwnload | server_cmd | orbit_windows | orbit_power,
 
       _action          = _operation << 8,  // Action permission group
       list             = _action << 0,     // Allow list apps
@@ -307,7 +309,9 @@
     file_upload: 0x00040000,
     file_dwnload: 0x00080000,
     server_cmd: 0x00100000,
-    _all_operations: 0x001F0000,
+    orbit_windows: 0x00200000, // ORBIT
+    orbit_power: 0x00400000, // ORBIT
+    _all_operations: 0x007F0000,
 
     // Action permission group
     list: 0x01000000,
@@ -319,7 +323,7 @@
     // Special permissions
     _default: 0x03000000,
